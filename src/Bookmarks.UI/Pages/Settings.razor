@page "/settings"
@implements IDisposable
@inject ThemeService ThemeState
@inject IAccountService Accounts
@inject ISyncService Sync
@inject IAppStatusService AppStatus
@inject AccountActions Actions
@inject IAccountDeletion Deletion
@inject IDeviceStorage Device
@inject IServerInfo Server
@inject ISnackbar Snackbar
@inject LibraryService LibraryData
@inject IFileSaver Files
@inject IDialogService Dialogs
@inject IBrowserViewportService Viewport
@using Bookmarks.Core.Transfer
@using Bookmarks.Shared.Backup

<PageTitle>Settings · Bookmarks</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="py-4 px-2 px-sm-4">
    <MudText Typo="Typo.h5" Class="mb-4">Settings</MudText>

    <div class="bm-settings">
        @* ---------- Appearance ---------- *@
        <MudPaper Outlined="true" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-3">Appearance</MudText>
            <MudText Typo="Typo.subtitle2" Class="mb-2">Theme</MudText>
            <MudToggleGroup T="ThemeMode" Value="ThemeState.Mode" ValueChanged="ThemeState.SetModeAsync"
                            Color="Color.Primary" Size="Size.Small">
                <MudToggleItem Value="ThemeMode.Light" Text="Light" />
                <MudToggleItem Value="ThemeMode.Dark" Text="Dark" />
                <MudToggleItem Value="ThemeMode.System" Text="Match system" />
            </MudToggleGroup>
            <MudText Typo="Typo.caption" Class="bm-settings__hint">
                @ThemeHint
            </MudText>
        </MudPaper>

        @* ---------- Account ---------- *@
        <MudPaper Outlined="true" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-3">Account</MudText>

            @if (!Accounts.IsSignInSupported)
            {
                <MudText Typo="Typo.body2">Your library is stored on this device only.</MudText>
            }
            else if (Accounts.Current.IsGuest)
            {
                <MudText Typo="Typo.body2" Class="mb-3">
                    You're not signed in, so your library is stored on this device only. Create an account to back it up
                    and keep it in sync across your devices.
                </MudText>
                <div class="bm-settings__actions">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd"
                               Disabled="@(Actions.IsBusy || !AppStatus.IsOnline)" OnClick="Actions.SignUpAsync">Create an account</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Login"
                               Disabled="@(Actions.IsBusy || !AppStatus.IsOnline)" OnClick="Actions.SignInAsync">Sign in</MudButton>
                </div>
                @if (!AppStatus.IsOnline)
                {
                    <MudText Typo="Typo.caption" Class="bm-settings__hint">You're offline. Sign in when you're back online.</MudText>
                }
            }
            else
            {
                <dl class="bm-settings__facts">
                    <dt>Signed in as</dt>
                    <dd>
                        @Accounts.Current.Label
                        @if (!string.IsNullOrWhiteSpace(Accounts.Current.Email) && Accounts.Current.Email != Accounts.Current.Label)
                        {
                            <span class="bm-settings__sub">@Accounts.Current.Email</span>
                        }
                    </dd>
                    <dt>Sync</dt>
                    <dd>@SyncText.Describe(Sync, DateTimeOffset.Now)</dd>
                </dl>
                <div class="bm-settings__actions">
                    @if (Sync.NeedsSignIn)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Login"
                                   Disabled="@(Actions.IsBusy || !AppStatus.IsOnline)" OnClick="RenewSignInAsync">Sign in again</MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Sync"
                                   Disabled="@(Actions.IsBusy || !AppStatus.IsOnline || Sync.Status == SyncStatus.Syncing)"
                                   OnClick="Actions.SyncNowAsync">Sync now</MudButton>
                    }
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Logout"
                               Disabled="@Actions.IsBusy" OnClick="Actions.SignOutAsync">Sign out</MudButton>
                </div>

                @if (Deletion.IsSupported)
                {
                    <MudDivider Class="my-4" />
                    <MudText Typo="Typo.subtitle2">Delete account</MudText>
                    <MudText Typo="Typo.body2" Class="mb-3">
                        Permanently deletes your library from Bookmarks, on the server and on this device.
                        Your email and password sign-in is kept; signing in again starts an empty library.
                    </MudText>
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteForever"
                               Disabled="@(Actions.IsBusy || !AppStatus.IsOnline)" OnClick="Actions.DeleteAccountAsync">Delete account…</MudButton>
                    @if (!AppStatus.IsOnline)
                    {
                        <MudText Typo="Typo.caption" Class="bm-settings__hint">Needs a connection.</MudText>
                    }
                }
            }
        </MudPaper>

        @* ---------- Your data (Phase 7b) ---------- *@
        @if (Files.IsSupported)
        {
            @* Focusable so /settings?section=data (the empty library's "Import a library" button) can scroll here. *@
            <div id="your-data" class="bm-settings__anchor" tabindex="-1" @ref="_yourDataSection">
            <MudPaper Outlined="true" Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-3">Your data</MudText>

                <MudText Typo="Typo.subtitle2">Backup</MudText>
                <MudText Typo="Typo.body2" Class="mb-3">
                    One file with your whole library: books, reads, notes, bookcases and shelves. Restore it on any device,
                    signed in or not.
                </MudText>
                <div class="bm-settings__actions">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download"
                               Disabled="@DataDisabled" OnClick="DownloadBackupAsync">Download backup</MudButton>
                    <MudButton HtmlTag="label" for="bm-restore-file" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Restore"
                               Disabled="@DataDisabled">Restore from backup…</MudButton>
                </div>
                <InputFile @key="RestoreInputKey" id="bm-restore-file" accept=".json,application/json" style="display:none"
                           disabled="@DataDisabled" OnChange="OnBackupChosenAsync" />

                <MudDivider Class="my-4" />

                <MudText Typo="Typo.subtitle2">Goodreads</MudText>
                <MudText Typo="Typo.body2" Class="mb-3">
                    Import the file Goodreads exports (My Books → Import and export → Export Library), or export your library
                    in the same format for Goodreads or a spreadsheet.
                </MudText>
                <div class="bm-settings__actions">
                    <MudButton HtmlTag="label" for="bm-goodreads-file" Variant="Variant.Outlined" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.FileUpload" Disabled="@DataDisabled">Import from Goodreads…</MudButton>
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FileDownload"
                               Disabled="@DataDisabled" OnClick="ExportGoodreadsAsync">Export for Goodreads</MudButton>
                </div>
                <InputFile @key="GoodreadsInputKey" id="bm-goodreads-file" accept=".csv,text/csv" style="display:none"
                           disabled="@DataDisabled" OnChange="OnGoodreadsChosenAsync" />

                @if (_dataBusy)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-4" />
                }
            </MudPaper>
            </div>
        }

        @* ---------- This device ---------- *@
        @if (Device.IsSupported)
        {
            <MudPaper Outlined="true" Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-3">This device</MudText>

                @if (_storage is null)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                }
                else
                {
                    <dl class="bm-settings__facts">
                        <dt>Storage used</dt>
                        <dd>
                            @StorageUsedText
                            @if (StoragePercent is { } percent)
                            {
                                <MudProgressLinear Value="@percent" Color="Color.Primary" Rounded="true" Size="Size.Small" Class="mt-1" />
                            }
                        </dd>

                        <dt>Persistent storage</dt>
                        <dd>
                            @PersistenceText
                            @if (_storage.IsPersisted == false && _storage.CanRequestPersistence)
                            {
                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="ml-1"
                                           Disabled="@_requesting" OnClick="RequestPersistenceAsync">Request</MudButton>
                            }
                        </dd>

                        @if (_storage.CoverCount is { } covers)
                        {
                            <dt>Saved covers</dt>
                            <dd>@CoversText(covers, _storage.CoverBytes)</dd>
                        }
                    </dl>
                }

                <MudDivider Class="my-4" />
                <MudText Typo="Typo.subtitle2">Erase this device's data</MudText>
                <MudText Typo="Typo.body2" Class="mb-3">
                    @(Accounts.Current.IsGuest
                        ? "Deletes the library stored on this device. You're not signed in, so it isn't backed up anywhere."
                        : "Removes your library from this device and downloads it again from your account. You stay signed in.")
                </MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.PhonelinkErase"
                           Disabled="@Actions.IsBusy" OnClick="Actions.EraseThisDeviceAsync">Erase this device's data…</MudButton>
            </MudPaper>
        }

        @* ---------- About ---------- *@
        <MudPaper Outlined="true" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-3">About</MudText>
            <dl class="bm-settings__facts">
                <dt>App version</dt>
                <dd>@_appVersion</dd>
                @if (Accounts.IsSignInSupported)
                {
                    <dt>Service version</dt>
                    <dd>@ApiVersionText</dd>
                }
                <dt>Updates</dt>
                <dd>
                    @if (AppStatus.UpdateAvailable)
                    {
                        <span>A new version is ready.</span>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="ml-1"
                                   StartIcon="@Icons.Material.Filled.Refresh" OnClick="AppStatus.ApplyUpdateAsync">Reload</MudButton>
                    }
                    else
                    {
                        if (_updateText is not null)
                        {
                            <span>@_updateText</span>
                        }
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="@UpdateButtonClass"
                                   Disabled="@(_checkingUpdates || !AppStatus.IsOnline)" OnClick="CheckForUpdatesAsync">
                            @(_checkingUpdates ? "Checking…" : "Check for updates")
                        </MudButton>
                    }
                </dd>
            </dl>
            <MudText Typo="Typo.body2" Class="mt-3">
                Book details and covers from
                <MudLink Href="https://openlibrary.org" Target="_blank" rel="noopener">Open Library</MudLink>.
            </MudText>
        </MudPaper>
    </div>
</MudContainer>

@code {
    /// <summary>"data" scrolls to Your data (from the empty library).</summary>
    [SupplyParameterFromQuery(Name = "section")]
    public string? Section { get; set; }

    private ElementReference _yourDataSection;

    private DeviceStorageInfo? _storage;
    private bool _requesting;
    private string _appVersion = "";
    private string? _apiVersion;
    private bool _apiVersionLoaded;

    protected override void OnInitialized()
    {
        _appVersion = SettingsText.FormatVersion(SettingsText.AppInformationalVersion());

        ThemeState.Changed += OnChanged;
        Accounts.Changed += OnChanged;
        Sync.Changed += OnChanged;
        AppStatus.Changed += OnChanged;
        Actions.Changed += OnChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && string.Equals(Section, "data", StringComparison.OrdinalIgnoreCase) && Files.IsSupported)
        {
            try
            {
                // Focusing scrolls the section into view; no JS needed.
                await _yourDataSection.FocusAsync(preventScroll: false);
            }
            catch (Exception ex) when (ex is not OperationCanceledException)
            {
                // Not worth an error: the user can scroll.
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadStorageAsync(), LoadApiVersionAsync());
    }

    public void Dispose()
    {
        ThemeState.Changed -= OnChanged;
        Accounts.Changed -= OnChanged;
        Sync.Changed -= OnChanged;
        AppStatus.Changed -= OnChanged;
        Actions.Changed -= OnChanged;
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    // ---------- Your data ----------

    private const long MaxBackupBytes = 100L * 1024 * 1024;
    private const long MaxCsvBytes = 20L * 1024 * 1024;

    private bool _dataBusy;

    // A new key gives a fresh <input type=file>, so choosing the same file again still raises OnChange.
    private int _restoreInputKey;
    private int _goodreadsInputKey;

    // The two inputs are siblings, so their keys must differ from each other too.
    private string RestoreInputKey => "restore-" + _restoreInputKey;

    private string GoodreadsInputKey => "goodreads-" + _goodreadsInputKey;

    private bool DataDisabled => _dataBusy || Actions.IsBusy;

    private async Task DownloadBackupAsync()
    {
        _dataBusy = true;
        try
        {
            var (fileName, json) = await LibraryData.CreateBackupAsync(SettingsText.AppInformationalVersion());
            await Files.SaveTextAsync(fileName, "application/json", json);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Snackbar.Add("Couldn't create the backup. Please try again.", Severity.Error);
        }
        finally
        {
            _dataBusy = false;
        }
    }

    private async Task OnBackupChosenAsync(InputFileChangeEventArgs e)
    {
        _restoreInputKey++;
        if (_dataBusy || await ReadFileAsync(e.File, MaxBackupBytes) is not { } text)
        {
            return;
        }

        LibraryBackup backup;
        try
        {
            backup = LibraryBackups.Parse(text);
        }
        catch (BackupFormatException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            { nameof(RestoreBackupDialog.Summary), LibraryBackups.Summarize(backup, LibraryData.CurrentUserId) },
        };
        var dialog = await Dialogs.ShowAsync<RestoreBackupDialog>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not RestoreMode mode)
        {
            return;
        }

        _dataBusy = true;
        StateHasChanged();
        try
        {
            var restored = await LibraryData.RestoreBackupAsync(backup, mode);
            Snackbar.Add(RestoreText(restored, mode), Severity.Success);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Snackbar.Add("The restore didn't finish. Part of the backup may have been restored; restoring again is safe.", Severity.Error);
        }
        finally
        {
            _dataBusy = false;
        }
    }

    private async Task ExportGoodreadsAsync()
    {
        _dataBusy = true;
        try
        {
            var (fileName, csv) = await LibraryData.ExportGoodreadsAsync();
            await Files.SaveTextAsync(fileName, "text/csv;charset=utf-8", csv);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Snackbar.Add("Couldn't create the export. Please try again.", Severity.Error);
        }
        finally
        {
            _dataBusy = false;
        }
    }

    private async Task OnGoodreadsChosenAsync(InputFileChangeEventArgs e)
    {
        _goodreadsInputKey++;
        if (_dataBusy || await ReadFileAsync(e.File, MaxCsvBytes) is not { } text)
        {
            return;
        }

        IReadOnlyList<GoodreadsBook> rows;
        try
        {
            rows = GoodreadsCsv.Parse(text);
        }
        catch (GoodreadsFormatException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
            return;
        }

        if (rows.Count == 0)
        {
            Snackbar.Add("There are no books in that file.", Severity.Info);
            return;
        }

        var parameters = new DialogParameters { { nameof(GoodreadsImportDialog.Rows), rows } };
        var dialog = await Dialogs.ShowAsync<GoodreadsImportDialog>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not GoodreadsImportPlan plan)
        {
            return;
        }

        var message = plan.NewBooks == 1 ? "Imported 1 book" : $"Imported {plan.NewBooks} books";
        if (plan.ExistingUpdated > 0)
        {
            message += plan.ExistingUpdated == 1 ? " and updated 1 you already had" : $" and updated {plan.ExistingUpdated} you already had";
        }

        Snackbar.Add(message + ".", Severity.Success);

        if (plan.NewBooks > 0 && AppStatus.IsOnline)
        {
            var findCovers = await Dialogs.ShowMessageBoxAsync(
                "Find covers?",
                "Goodreads doesn't export covers. Look up covers and missing details for your books on Open Library now? You can also do it later from the library's Find covers button.",
                yesText: "Find covers", cancelText: "Later");
            if (findCovers == true)
            {
                var options = await DialogDefaults.EditorAsync(Viewport, MaxWidth.Small);
                await Dialogs.ShowAsync<FindCoversDialog>(null, new DialogParameters(), options);
            }
        }
    }

    /// <summary>The chosen file's text, or null (with a message) when it's too big or can't be read.</summary>
    private async Task<string?> ReadFileAsync(IBrowserFile file, long maxBytes)
    {
        if (file.Size > maxBytes)
        {
            Snackbar.Add($"That file is too large ({SettingsText.FormatBytes(file.Size)}).", Severity.Warning);
            return null;
        }

        try
        {
            await using var stream = file.OpenReadStream(maxBytes);
            using var reader = new StreamReader(stream);
            return await reader.ReadToEndAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Snackbar.Add("Couldn't read that file.", Severity.Error);
            return null;
        }
    }

    private static string RestoreText(RestoreResult r, RestoreMode mode)
    {
        static string Books(int n) => n == 1 ? "1 book" : $"{n} books";

        if (mode == RestoreMode.Replace)
        {
            var text = $"Your library now matches the backup: {Books(r.Added + r.Updated)} restored";
            return r.Removed > 0 ? text + $", {Books(r.Removed)} removed." : text + ".";
        }

        if (r.Added == 0 && r.Updated == 0)
        {
            return "Nothing to restore: your library already has everything in this backup.";
        }

        var merged = $"Restored {Books(r.Added)}";
        if (r.Updated > 0)
        {
            merged += $" and updated {Books(r.Updated)}";
        }

        return r.Kept switch
        {
            0 => merged + ".",
            1 => merged + ". 1 book was newer here and kept as it is.",
            _ => merged + $". {r.Kept} books were newer here and kept as they are.",
        };
    }

    private async Task LoadStorageAsync()
    {
        if (!Device.IsSupported)
        {
            return;
        }

        try
        {
            _storage = await Device.GetInfoAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _storage = new DeviceStorageInfo(null, null, null, false, null, null);
        }
    }

    private async Task LoadApiVersionAsync()
    {
        try
        {
            _apiVersion = await Server.GetApiVersionAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _apiVersion = null;
        }

        _apiVersionLoaded = true;
    }

    private async Task RequestPersistenceAsync()
    {
        _requesting = true;
        try
        {
            var granted = await Device.RequestPersistenceAsync();
            if (!granted)
            {
                Snackbar.Add("The browser said no for now. Installing Bookmarks as an app usually lets it keep your data.", Severity.Info);
            }

            await LoadStorageAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Snackbar.Add("Couldn't ask the browser right now.", Severity.Warning);
        }
        finally
        {
            _requesting = false;
        }
    }

    private async Task RenewSignInAsync()
    {
        try
        {
            await Accounts.RenewSignInAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Snackbar.Add("Sign-in couldn't start. Please try again.", Severity.Error);
        }
    }

    private string ThemeHint => ThemeState.Mode != ThemeMode.System
        ? "Saved on this device."
        : ThemeState.IsDarkMode
            ? "Follows your device's setting (dark right now)."
            : "Follows your device's setting (light right now).";

    private string StorageUsedText => _storage switch
    {
        { UsageBytes: { } used, QuotaBytes: { } quota } when quota > 0
            => $"{SettingsText.FormatBytes(used)} of {SettingsText.FormatBytes(quota)} available",
        { UsageBytes: { } used } => SettingsText.FormatBytes(used),
        _ => "Unknown",
    };

    private double? StoragePercent => _storage is { UsageBytes: { } used, QuotaBytes: { } quota } && quota > 0
        ? Math.Clamp(100.0 * used / quota, 0, 100)
        : null;

    private string PersistenceText => _storage?.IsPersisted switch
    {
        true => "Granted: the browser won't clear your library to free up space.",
        false => "Not granted: the browser may clear data if the device runs low on space.",
        _ => "Unknown on this browser.",
    };

    private static string CoversText(int count, long? bytes)
    {
        var what = count == 1 ? "1 cover" : $"{count} covers";
        return bytes is { } b && count > 0 ? $"{what}, {SettingsText.FormatBytes(b)}" : what;
    }

    private bool _checkingUpdates;

    private string UpdateButtonClass => _updateText is null ? "bm-settings__update" : "bm-settings__update ml-1";
    private string? _updateText;

    private async Task CheckForUpdatesAsync()
    {
        _checkingUpdates = true;
        _updateText = null;
        try
        {
            _updateText = await AppStatus.CheckForUpdateAsync() switch
            {
                UpdateCheckResult.UpToDate => "You have the latest version.",
                UpdateCheckResult.Downloading => "Downloading a new version…",
                UpdateCheckResult.Ready => null, // UpdateAvailable shows Reload
                UpdateCheckResult.Failed => "Couldn't check right now.",
                _ => "Updates aren't available in this build.",
            };
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _updateText = "Couldn't check right now.";
        }
        finally
        {
            _checkingUpdates = false;
        }
    }

    private string ApiVersionText => !_apiVersionLoaded
        ? "Checking…"
        : _apiVersion is { } v
            ? SettingsText.FormatVersion(v)
            : AppStatus.IsOnline ? "Unavailable" : "Unavailable offline";
}
