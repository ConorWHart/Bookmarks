@page "/bookcases"
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject LibraryService LibraryData
@inject IDialogService Dialogs
@inject IJSRuntime JS

<PageTitle>Manage bookcases · Bookmarks</PageTitle>

@* Phase 8d: a compact list, one row per bookcase. Tap a row to change that bookcase in a sheet (BookcaseSheet: name,
   colour, show in the library, shelves, delete). Reordering is its own mode, with big up/down buttons and a drag grip,
   so scrolling the list never moves anything by accident. The eye shows or hides a bookcase in the library. *@
<MudContainer MaxWidth="MaxWidth.Small" Class="py-4 px-2 px-sm-4">

    <div class="bm-bc-top">
        <div class="bm-bc-top__text">
            <MudText Typo="Typo.h5">Manage bookcases</MudText>
            <MudText Typo="Typo.body2" Class="bm-bc-top__hint">
                @(_reordering ? "Drag a bookcase by its grip, or use the arrows." : "Tap a bookcase to rename it or change its colour and shelves.")
            </MudText>
        </div>
        @if (_loaded && LibraryData.Bookcases.Count > 1)
        {
            <MudButton Variant="@(_reordering ? Variant.Filled : Variant.Outlined)" Color="Color.Primary"
                       StartIcon="@(_reordering ? Icons.Material.Filled.Check : Icons.Material.Filled.SwapVert)"
                       OnClick="() => _reordering = !_reordering">@(_reordering ? "Done" : "Reorder")</MudButton>
        }
    </div>

    @if (!_loaded)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (LibraryData.Bookcases.Count == 0)
    {
        <MudPaper Elevation="0" Class="pa-6 bm-panel">
            <MudStack Spacing="3" AlignItems="AlignItems.Start">
                <MudText Typo="Typo.body1">
                    No bookcases yet. Make one for each real bookcase at home, or for any set you like (Favorites, Want to
                    buy): a book can stand in several. Then fill the shelves with "Add book to shelf" in the library.
                </MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AddBookcaseAsync">Add your first bookcase</MudButton>
            </MudStack>
        </MudPaper>
    }
    else
    {
        var bookcases = LibraryData.Bookcases;
        <div class="@(_reordering ? "bm-bc-list bm-bc-list--reordering" : "bm-bc-list")" data-sort-list="bookcases" @ref="_list">
            @for (var i = 0; i < bookcases.Count; i++)
            {
                var bookcase = bookcases[i];
                var index = i;
                <div class="@(bookcase.IsHidden ? "bm-bc-row bm-bc-row--hidden" : "bm-bc-row")" @key="bookcase.Id"
                     data-sort-item="bookcases" data-sort-id="@bookcase.Id">
                    @if (_reordering)
                    {
                        <span class="bm-bc-row__grip" data-sort-handle="bookcases" title="Drag to reorder">
                            <MudIcon Icon="@Icons.Material.Filled.DragIndicator" />
                        </span>
                        <div class="bm-bc-row__main">
                            <FinishSwatch Theme="@bookcase.Theme" CustomColor="@bookcase.CustomColor" />
                            <span class="bm-bc-row__text">
                                <span class="bm-bc-row__name">@bookcase.Name</span>
                            </span>
                        </div>
                        <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Disabled="index == 0"
                                       OnClick="() => LibraryData.MoveBookcaseAsync(bookcase.Id, -1)" aria-label="@($"Move {bookcase.Name} up")" />
                        <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Disabled="index == bookcases.Count - 1"
                                       OnClick="() => LibraryData.MoveBookcaseAsync(bookcase.Id, 1)" aria-label="@($"Move {bookcase.Name} down")" />
                    }
                    else
                    {
                        <button type="button" class="bm-bc-row__main bm-bc-row__open" @onclick="() => OpenAsync(bookcase.Id)">
                            <FinishSwatch Theme="@bookcase.Theme" CustomColor="@bookcase.CustomColor" />
                            <span class="bm-bc-row__text">
                                <span class="bm-bc-row__name">@bookcase.Name</span>
                                <span class="bm-bc-row__meta">@Summary(bookcase)</span>
                            </span>
                            <span class="bm-bc-row__chevron"><MudIcon Icon="@Icons.Material.Filled.ChevronRight" /></span>
                        </button>
                        <MudIconButton Icon="@(bookcase.IsHidden ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)"
                                       Color="@(bookcase.IsHidden ? Color.Default : Color.Primary)"
                                       OnClick="() => LibraryData.SetBookcaseHiddenAsync(bookcase.Id, !bookcase.IsHidden)"
                                       aria-pressed="@(bookcase.IsHidden ? "false" : "true")"
                                       aria-label="@EyeLabel(bookcase)" />
                    }
                </div>
            }
        </div>

        @if (!_reordering)
        {
            <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Class="mt-2"
                       OnClick="AddBookcaseAsync">Add a bookcase</MudButton>
        }

        @* Room so the floating button never covers the last row. *@
        <div class="bm-bc-clearance" aria-hidden="true"></div>
    }
</MudContainer>

@if (_loaded && LibraryData.Bookcases.Count > 0 && !_reordering)
{
    <MudFab Class="bm-fab" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Label="New bookcase"
            OnClick="AddBookcaseAsync" aria-label="Add a new bookcase" />
}

@code {
    private bool _loaded;
    private bool _reordering;

    protected override async Task OnInitializedAsync()
    {
        LibraryData.Changed += OnLibraryChanged;
        await LibraryData.EnsureLoadedAsync();
        _loaded = true;
    }

    private string Summary(Bookcase bookcase)
    {
        var shelves = LibraryData.ShelvesIn(bookcase.Id);
        var books = shelves.Sum(s => LibraryData.ShelfUsage(s.Id).Count);
        var text = $"{Plural(shelves.Count, "shelf", "shelves")} · {Plural(books, "book", "books")}";
        return bookcase.IsHidden ? text + " · hidden" : text;
    }

    private static string EyeLabel(Bookcase bookcase) => bookcase.IsHidden
        ? $"{bookcase.Name} is hidden in the library: show it"
        : $"{bookcase.Name} is shown in the library: hide it";

    private Task OpenAsync(Guid bookcaseId) => BookcaseSheet.OpenAsync(Dialogs, bookcaseId);

    /// <summary>A new bookcase opens straight away in its sheet, name ready to type.</summary>
    private async Task AddBookcaseAsync()
    {
        var id = await LibraryData.AddBookcaseAsync();
        await BookcaseSheet.OpenAsync(Dialogs, id, isNew: true);
    }

    // ---------- Drag to reorder (Phase 6c, Reorder mode since 8d): listDrag.js handles the gesture by the grips ----------

    private ElementReference _list;
    private IJSObjectReference? _dragModule;
    private DotNetObjectReference<Bookcases>? _dragRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_loaded || LibraryData.Bookcases.Count == 0)
        {
            return;
        }

        try
        {
            // The grips only exist in Reorder mode, so outside it nothing can be dragged.
            _dragModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Bookmarks.UI/js/listDrag.js");
            _dragRef ??= DotNetObjectReference.Create(this);
            await _dragModule.InvokeVoidAsync("sync", _list, _dragRef);
        }
        catch (JSException ex)
        {
            // The arrows still reorder.
            Console.Error.WriteLine($"Drag to reorder unavailable: {ex.Message}");
        }
    }

    /// <summary>Called by listDrag.js when a bookcase is dropped at a new position.</summary>
    [JSInvokable]
    public Task OnReordered(string kind, string id, int from, int to)
    {
        if (kind != "bookcases" || !Guid.TryParse(id, out var guid) || from == to)
        {
            return Task.CompletedTask;
        }

        return LibraryData.MoveBookcaseAsync(guid, to - from);
    }

    public async ValueTask DisposeAsync()
    {
        LibraryData.Changed -= OnLibraryChanged;
        if (_dragModule is not null)
        {
            try
            {
                await _dragModule.InvokeVoidAsync("dispose");
                await _dragModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
            catch (JSException)
            {
            }
        }
        _dragRef?.Dispose();
    }

    private void OnLibraryChanged() => _ = InvokeAsync(StateHasChanged);

    private static string Plural(int n, string one, string many) => n == 1 ? $"1 {one}" : $"{n} {many}";
}
