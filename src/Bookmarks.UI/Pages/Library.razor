@page "/"
@using Microsoft.JSInterop
@implements IDisposable
@inject LibraryService LibraryData
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject UserPreferences Prefs
@inject IBrowserViewportService Viewport

<PageTitle>Library · Bookmarks</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4 px-2 px-sm-4">

    @if (_loadError is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">
            Couldn't open the library storage on this device: @_loadError
        </MudAlert>
    }
    else if (!_loaded)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (LibraryData.IsEmpty)
    {
        <MudPaper Elevation="0" Class="pa-8 mx-auto bm-panel" Style="max-width:560px">
            <MudStack AlignItems="AlignItems.Center" Spacing="3">
                <MudIcon Icon="@Icons.Material.Outlined.LocalLibrary" Color="Color.Primary" Style="font-size:3.5rem" />
                <MudText Typo="Typo.h5">Your library is empty</MudText>
                <MudText Typo="Typo.body1" Align="Align.Center">
                    Add your first book, or load a demo library to explore the bookcases.
                    Everything is stored on this device and works offline.
                </MudText>
                <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" Justify="Justify.Center">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                               OnClick="() => OpenEditorAsync(null)" Disabled="_busy">Add a new book</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AutoStories"
                               OnClick="LoadDemoAsync" Disabled="_busy">Load demo library</MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>
    }
    else
    {
        @* ---------- Toolbar: full on wider screens ---------- *@
        <MudPaper Elevation="0" Class="pa-3 mb-5 bm-panel d-none d-md-block">
            <MudGrid Spacing="2" Class="align-center">
                <MudItem md="4">
                    <div class="bm-display">
                        <MudToggleGroup T="LibraryDisplay" Value="_view.Display" ValueChanged="v => SetView(_view with { Display = v })"
                                        Color="Color.Primary" Outlined="true" Class="bm-display-toggle">
                            <MudToggleItem Value="LibraryDisplay.Bookcases" Text="Bookcases" />
                            <MudToggleItem Value="LibraryDisplay.Books" Text="Books" />
                        </MudToggleGroup>
                    </div>
                </MudItem>

                <MudItem md="4">
                    <MudTextField T="string" @bind-Value="_search" @bind-Value:after="OnSearchChanged"
                                  Placeholder="Search title, author, series, ISBN"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                  Immediate="true" DebounceInterval="200" Clearable="true"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>

                <MudItem md="2">
                    <MudSelect T="OwnershipStatus" MultiSelection="true" Label="Status"
                               SelectedValues="_view.Filter.Statuses" SelectedValuesChanged="SetStatuses"
                               MultiSelectionTextFunc="StatusText" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                        @foreach (var (status, label) in LibraryLabels.Statuses)
                        {
                            <MudSelectItem Value="status">@label</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem md="2">
                    <MudSelect T="ReadState" Value="_view.Filter.ReadState" ValueChanged="v => SetView(_view.WithFilter(_view.Filter with { ReadState = v }))"
                               Label="Read" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                        <MudSelectItem Value="ReadState.Any">Any</MudSelectItem>
                        <MudSelectItem Value="ReadState.Read">Read</MudSelectItem>
                        <MudSelectItem Value="ReadState.ToRead">To read</MudSelectItem>
                        <MudSelectItem Value="ReadState.Reading">Reading now</MudSelectItem>
                        <MudSelectItem Value="ReadState.Unread">Unread</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" Class="d-flex flex-wrap align-center gap-3">
                    @if (IsBooks)
                    {
                        <MudSelect T="LibrarySortField" Value="_view.Query.Sort.Field" ValueChanged="v => SetView(_view.WithSort(_view.Query.Sort with { Field = v }))"
                                   Label="Sort" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="max-width:180px">
                            @foreach (var (field, label) in LibraryLabels.SortOptions)
                            {
                                <MudSelectItem Value="field">@label</MudSelectItem>
                            }
                        </MudSelect>

                        <MudIconButton Icon="@(_view.Query.Sort.Descending ? Icons.Material.Filled.ArrowDownward : Icons.Material.Filled.ArrowUpward)"
                                       Size="Size.Small" OnClick="ToggleDirection" aria-label="Toggle sort direction" />

                        <MudSelect T="LibraryGroupBy" Value="_view.Query.GroupBy" ValueChanged="v => SetView(_view.WithGroupBy(v))" Label="Group"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="max-width:160px">
                            @foreach (var (group, label) in LibraryLabels.GroupOptions)
                            {
                                <MudSelectItem Value="group">@label</MudSelectItem>
                            }
                        </MudSelect>
                    }

                    <MudBadge Content="_view.Filter.ActiveCount" Visible="@(_view.Filter.ActiveCount > 0)" Color="Color.Primary" Overlap="true">
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Tune" OnClick="OpenFiltersAsync">Filters</MudButton>
                    </MudBadge>

                    @if (!IsBooks)
                    {
                        <ShelfVisibility />

                        <MudButton Href="bookcases" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Edit">Edit bookcases</MudButton>
                    }

                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.ImageSearch" OnClick="OpenFindCoversAsync">Find covers</MudButton>

                    @if (!IsBooks)
                    {
                        <div style="width:160px">
                            <MudSlider T="double" @bind-Value="_scale" @bind-Value:after="SaveScale" Min="FilterPanel.MinScale" Max="FilterPanel.MaxScale" Step="0.05" Size="Size.Small">Size</MudSlider>
                        </div>
                    }

                    <MudSpacer />
                    <MudText Typo="Typo.caption">@_matchCount of @LibraryData.Entries.Count books</MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>

        @* ---------- Toolbar: phones get the toggle, search and a Filters sheet ---------- *@
        <div class="bm-display d-flex d-md-none mb-2">
            <MudToggleGroup T="LibraryDisplay" Value="_view.Display" ValueChanged="v => SetView(_view with { Display = v })"
                            Color="Color.Primary" Outlined="true" Class="bm-display-toggle">
                <MudToggleItem Value="LibraryDisplay.Bookcases" Text="Bookcases" />
                <MudToggleItem Value="LibraryDisplay.Books" Text="Books" />
            </MudToggleGroup>
        </div>
        <div class="d-flex d-md-none align-center gap-2 mb-1">
            <div class="flex-grow-1">
                <MudTextField T="string" @bind-Value="_search" @bind-Value:after="OnSearchChanged"
                              Placeholder="Search" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true" DebounceInterval="200" Clearable="true"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
            </div>
            <MudBadge Content="_view.Filter.ActiveCount" Visible="@(_view.Filter.ActiveCount > 0)" Color="Color.Primary" Overlap="true">
                <MudIconButton Icon="@Icons.Material.Filled.Tune" Variant="Variant.Outlined" Color="Color.Primary"
                               OnClick="OpenFiltersAsync" aria-label="Filters and view options" />
            </MudBadge>
        </div>
        <MudText Typo="Typo.caption" Class="d-block d-md-none mb-3">@_matchCount of @LibraryData.Entries.Count books</MudText>

        @* ---------- Library ---------- *@
        if (IsBooks)
        {
            if (_view.Query.GroupBy == LibraryGroupBy.None)
            {
                <CoverGrid Entries="_filtered" OnSelected="Select" />
            }
            else
            {
                foreach (var group in _groups)
                {
                    <section class="bm-group" @key="group.Key">
                        <MudText Typo="Typo.h6" Class="bm-group__title">@group.Key <span class="bm-group__count">@group.Entries.Count</span></MudText>
                        <CoverGrid Entries="group.Entries" OnSelected="Select" />
                    </section>
                }
            }
        }
        else if (LibraryData.Bookcases.Count == 0)
        {
            <MudPaper Elevation="0" Class="pa-6 bm-panel">
                <MudStack Spacing="2" AlignItems="AlignItems.Start">
                    <MudText Typo="Typo.body1">
                        No bookcases yet. Make one for each real bookcase, or for any set you like (Favorites, Want to buy):
                        a book can stand in several.
                    </MudText>
                    <MudButton Href="bookcases" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ViewWeek">Set up a bookcase</MudButton>
                </MudStack>
            </MudPaper>
        }
        else
        {
            <div class="bm-room">
            @foreach (var bookcase in LibraryData.Bookcases.Where(b => !b.IsHidden))
            {
                <BookcaseFrame @key="bookcase.Id" Title="@bookcase.Name" Theme="@bookcase.Theme">
                    @foreach (var shelf in LibraryData.ShelvesIn(bookcase.Id))
                    {
                        <ShelfRowView @key="shelf.Id" Books="PlaceOnShelf(shelf.Id)" Label="@LibraryData.ShelfLabel(shelf)"
                                      WidthMm="shelf.WidthMm" Scale="_scale" IsDimmed="IsDimmed" OnSelected="Select" />
                    }
                </BookcaseFrame>
            }
            </div>

            @if (LibraryData.HiddenBookcaseCount > 0)
            {
                <MudText Typo="Typo.caption" Class="d-block mt-2">@HiddenBookcasesText</MudText>
            }
        }
    }
</MudContainer>

<MudDrawer @bind-Open="_detailsOpen" Anchor="Anchor.End" Variant="DrawerVariant.Temporary" Width="400px" Elevation="2">
    <BookDetails Entry="_selected" OnEdit="OpenEditorAsync" OnDelete="DeleteAsync" OnClose="() => _detailsOpen = false" />
</MudDrawer>

<MudDrawer @bind-Open="_filtersOpen" Anchor="_filtersAnchor" Variant="DrawerVariant.Temporary" Elevation="2"
           Width="@FiltersWidth" Height="@FiltersHeight" Class="@FiltersClass">
    <div class="bm-filter-drawer__head">
        <MudText Typo="Typo.h6">@(IsSheet ? "View" : "Filters")</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="@(_view.Filter.ActiveCount == 0)"
                   OnClick="() => SetView(_view.ClearFilters())">Clear filters</MudButton>
        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="() => _filtersOpen = false" aria-label="Close" />
    </div>
    <div class="bm-filter-drawer__body">
        <FilterPanel View="_view" ViewChanged="SetView" ShowLayout="IsSheet" Scale="_scale" ScaleChanged="OnScaleChanged" />
        @if (IsSheet)
        {
            @if (!IsBooks)
            {
                <MudDivider Class="my-3" />
                <ShelfVisibility AsList="true" />
            }
            <MudStack Row="true" Spacing="1" Class="mt-2" Wrap="Wrap.Wrap">
                <MudButton Href="bookcases" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Edit">Edit bookcases</MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.ImageSearch"
                           OnClick="OpenFindCoversFromSheetAsync">Find covers</MudButton>
            </MudStack>
        }
    </div>
    <div class="bm-filter-drawer__foot">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="() => _filtersOpen = false">
            @ShowBooksText
        </MudButton>
    </div>
</MudDrawer>

@if (_loaded && _loadError is null && !LibraryData.IsEmpty)
{
    @if (IsBooks)
    {
        <MudFab Class="bm-fab" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Label="Add new book"
                OnClick="() => OpenEditorAsync(null)" aria-label="Add a new book to your library" />
    }
    else
    {
        <MudFab Class="bm-fab" Color="Color.Primary" StartIcon="@Icons.Material.Filled.LibraryAdd" Label="Add book to shelf"
                OnClick="AddBooksToShelfAsync" aria-label="Add books to a shelf" />
    }
}

@code {
    private bool IsBooks => _view.Display == LibraryDisplay.Books;

    private string HiddenBookcasesText => LibraryData.HiddenBookcaseCount == 1
        ? "1 bookcase is hidden. Show it from the Bookcases menu (Filters on a phone)."
        : $"{LibraryData.HiddenBookcaseCount} bookcases are hidden. Show them from the Bookcases menu (Filters on a phone).";

    private bool _loaded;
    private string? _loadError;
    private bool _busy;
    private string? _search;
    private double _scale = 0.55;

    // The current view: display (Bookcases / Books), filter, sort and grouping.
    private LibraryView _view = LibraryView.Default;

    private bool _filtersOpen;
    private Anchor _filtersAnchor = Anchor.End;

    private LibraryFilter _filter = LibraryFilter.None;
    private IReadOnlyList<LibraryEntry> _filtered = [];
    private IReadOnlyList<LibraryGroup> _groups = [];
    private int _matchCount;

    private LibraryEntry? _selected;
    private bool _detailsOpen;

    protected override async Task OnInitializedAsync()
    {
        LibraryData.Changed += OnLibraryChanged;
        try
        {
            await LibraryData.EnsureLoadedAsync();
            var saved = await Prefs.GetDoubleAsync(UserPreferences.LibraryScale);
            _scale = Math.Clamp(saved ?? await DefaultScaleAsync(), FilterPanel.MinScale, FilterPanel.MaxScale);
            await RestoreViewAsync();
        }
        catch (JSException ex)
        {
            // IndexedDB unavailable (e.g. blocked storage or some private-browsing modes).
            _loadError = ex.Message;
            return;
        }

        _loaded = true;
        Recompute();
    }

    /// <summary>Until the user picks a size, start smaller on narrow screens so more books fit.</summary>
    private async Task<double> DefaultScaleAsync()
    {
        try
        {
            var window = await Viewport.GetCurrentBrowserWindowSizeAsync();
            return window.Width switch
            {
                < 600 => 0.4,
                < 960 => 0.45,
                < 1280 => 0.5,
                _ => 0.55,
            };
        }
        catch (JSException)
        {
            return 0.55;
        }
    }

    public void Dispose() => LibraryData.Changed -= OnLibraryChanged;

    /// <summary>Any write (here, in the drawer or in a dialog) reloads the library; re-run the query
    /// and swap the selected entry for its fresh copy (or close the drawer if it was deleted).</summary>
    private void OnLibraryChanged()
    {
        if (!_loaded)
        {
            return;
        }

        Recompute();
        if (_selected is not null)
        {
            _selected = LibraryData.Find(_selected.Id);
            _detailsOpen &= _selected is not null;
        }

        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>"Find covers &amp; details" for books already in the library (Phase 5).</summary>
    private async Task OpenFindCoversAsync()
    {
        var options = await DialogDefaults.EditorAsync(Viewport, MaxWidth.Small);
        await Dialogs.ShowAsync<FindCoversDialog>(null, new DialogParameters(), options);
    }

    /// <summary>Add (entry = null) or edit a book.</summary>
    private async Task OpenEditorAsync(LibraryEntry? entry)
    {
        var parameters = new DialogParameters
        {
            { nameof(BookEditorDialog.ItemId), entry?.Id },
        };
        var options = await DialogDefaults.EditorAsync(Viewport);
        var dialog = await Dialogs.ShowAsync<BookEditorDialog>(parameters, options);
        var result = await dialog.Result;
        if (result is not { Canceled: false, Data: Guid id } || LibraryData.Find(id) is not { } saved)
        {
            return;
        }

        if (entry is null)
        {
            // New books aren't on a shelf: offer that next (or just show the book when there are no bookcases yet).
            var canShelve = LibraryData.Bookcases.Count > 0;
            Snackbar.Add($"Added “{saved.Title}”", Severity.Success, o =>
            {
                o.Action = canShelve ? "Put on a shelf" : "View";
                o.ActionColor = Color.Inherit;
                o.OnClick = _ => canShelve ? PutNewBookOnShelfAsync(saved.Id) : ShowAsync(saved);
            });
        }
    }

    private async Task AddBooksToShelfAsync() => await ShelfPickerDialog.OpenAsync(Dialogs, Viewport);

    private Task PutNewBookOnShelfAsync(Guid itemId)
        => InvokeAsync(async () => await ShelfPickerDialog.OpenAsync(Dialogs, Viewport, [itemId]));

    private Task ShowAsync(LibraryEntry entry)
        => InvokeAsync(() =>
        {
            Select(entry);
            StateHasChanged();
        });

    /// <summary>Soft delete with an Undo in the snackbar.</summary>
    private async Task DeleteAsync(LibraryEntry entry)
    {
        _detailsOpen = false;
        await LibraryData.DeleteBookAsync(entry.Id);
        Snackbar.Add($"Deleted “{entry.Title}”", Severity.Normal, o =>
        {
            o.Action = "Undo";
            o.ActionColor = Color.Inherit;
            o.OnClick = _ => LibraryData.RestoreBookAsync(entry.Id);
        });
    }

    private Task SaveScale() => Prefs.SetDoubleAsync(UserPreferences.LibraryScale, _scale);

    private async Task LoadDemoAsync()
    {
        _busy = true;
        try
        {
            await LibraryData.LoadDemoLibraryAsync();
            Recompute();
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>The view this device used last (else the default: Bookcases, no filters).</summary>
    private async Task RestoreViewAsync()
    {
        var lastJson = await Prefs.GetStringAsync(UserPreferences.LibraryView);
        if (LibraryViewJson.FromJson(lastJson) is { } last)
        {
            _view = last;
        }
    }

    private void SetView(LibraryView view)
    {
        _view = view;
        Recompute();
        _ = PersistViewAsync();
    }

    private void OnSearchChanged() => SetView(_view.WithFilter(_view.Filter with { Search = _search }));

    private void SetStatuses(IReadOnlyCollection<OwnershipStatus>? statuses)
        => SetView(_view.WithFilter(_view.Filter with { Statuses = statuses is { Count: > 0 } ? statuses.ToHashSet() : null }));

    private static string StatusText(IReadOnlyList<string?>? values)
        => values is { Count: > 0 } ? string.Join(", ", values) : "All";

    /// <summary>Remembered per device (not synced), so the library reopens as it was left.</summary>
    private async Task PersistViewAsync()
    {
        try
        {
            await Prefs.SetStringAsync(UserPreferences.LibraryView, LibraryViewJson.ToJson(_view));
        }
        catch (JSException)
        {
            // A preference that didn't save just means the view resets on the next visit.
        }
    }

    // Phones (below the md breakpoint) get a bottom sheet with every option; wider screens a side panel of filters.
    private bool IsSheet => _filtersAnchor == Anchor.Bottom;

    private string? FiltersWidth => IsSheet ? null : "380px";

    private string? FiltersHeight => IsSheet ? "auto" : null;

    private string FiltersClass => IsSheet ? "bm-filter-drawer bm-filter-drawer--sheet" : "bm-filter-drawer";

    private string ShowBooksText => _matchCount == 1 ? "Show 1 book" : $"Show {_matchCount} books";

    private async Task OpenFiltersAsync()
    {
        var phone = false;
        try
        {
            phone = (await Viewport.GetCurrentBrowserWindowSizeAsync()).Width < 960;
        }
        catch (JSException)
        {
            // Keep the side panel.
        }

        _filtersAnchor = phone ? Anchor.Bottom : Anchor.End;
        _filtersOpen = true;
    }

    private async Task OpenFindCoversFromSheetAsync()
    {
        _filtersOpen = false;
        await OpenFindCoversAsync();
    }

    private async Task OnScaleChanged(double scale)
    {
        _scale = scale;
        await SaveScale();
    }

    private void Recompute()
    {
        _filter = _view.Filter;
        _filtered = LibraryQueryEngine.Apply(LibraryData.Entries, _filter, _view.Query.Sort);
        _groups = LibraryQueryEngine.Execute(LibraryData.Entries, _view.Query);
        _matchCount = _filtered.Count;
    }

    private void ToggleDirection() => SetView(_view.WithSort(_view.Query.Sort with { Descending = !_view.Query.Sort.Descending }));

    private bool IsDimmed(LibraryEntry entry) => !LibraryQueryEngine.Matches(entry, _filter);

    /// <summary>Books on a shelf in their saved order, sized for drawing.</summary>
    private IReadOnlyList<PlacedBook> PlaceOnShelf(Guid shelfId)
        => ShelfLayoutEngine.Flow(LibraryData.BooksOnShelf(shelfId), int.MaxValue).FirstOrDefault()?.Books ?? [];

    private void Select(LibraryEntry entry)
    {
        _selected = entry;
        _detailsOpen = true;
    }
}
