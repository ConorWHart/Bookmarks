@* Add or edit a book. Edits a BookEditModel copy; nothing is stored until Save. *@
@inject LibraryService LibraryData
@inject ICoverColorService CoverColors
@inject IAppStatusService AppStatus
@inject IDialogService Dialogs
@inject IBrowserViewportService Viewport

<MudDialog ContentClass="bm-editor-content">
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsNew ? "Add a book" : "Edit book")</MudText>
    </TitleContent>

    <DialogContent>
        <div class="bm-editor">
            <div class="bm-editor__form">

                @* ---------- Find on Open Library ---------- *@
                <BookFinder @ref="_finder" InitialQuery="@_initialQuery" AutoFocus="IsNew" OnFound="ApplyLookupAsync" OnIsbnNotFound="KeepIsbn" OnScanned="UseScannedIsbn" />
                @if (_lookupSummary is not null)
                {
                    <MudAlert Severity="Severity.Success" Dense="true" Class="mt-2" ShowCloseIcon="true" CloseIconClicked="() => _lookupSummary = null">
                        <div class="d-flex align-center flex-wrap gap-2">
                            <span>@_lookupSummary</span>
                            @if (_lastLookup is not null && !_replaced)
                            {
                                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" OnClick="ReplaceAllAsync">Replace all fields</MudButton>
                            }
                        </div>
                    </MudAlert>
                }

                @* ---------- Book ---------- *@
                <MudText Typo="Typo.subtitle2" Class="bm-editor__section">Book</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="12">
                        <MudTextField T="string" Value="_model.Isbn13" ValueChanged="OnIsbnChangedAsync" Label="ISBN"
                                      Immediate="true" DebounceInterval="600" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      HelperText="Enter an ISBN to fill in the rest from Open Library"
                                      Error="IsbnInvalid" ErrorText="Check the ISBN: the check digit doesn't match" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField T="string" @bind-Value="_model.Title" Label="Title" Required="true" RequiredError="A title is required"
                                      Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField T="string" @bind-Value="_model.Subtitle" Label="Subtitle" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField T="string" @bind-Value="_model.AuthorsText" Label="Authors" HelperText="Separate multiple authors with commas"
                                      Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="8">
                        <MudTextField T="string" @bind-Value="_model.Series" Label="Series" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="4">
                        <MudNumericField T="decimal?" @bind-Value="_model.SeriesNumber" Label="No." Min="0m" HideSpinButtons="true"
                                         Disabled="string.IsNullOrWhiteSpace(_model.Series)" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="4">
                        <MudNumericField T="int?" @bind-Value="_model.PageCount" Label="Pages" Min="1" HideSpinButtons="true"
                                         Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="4">
                        <MudNumericField T="int?" @bind-Value="_model.PublishedYear" Label="Year" HideSpinButtons="true"
                                         Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="4">
                        <MudTextField T="string" @bind-Value="_model.Publisher" Label="Publisher" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField T="string" @bind-Value="_model.GenresText" Label="Genres" HelperText="Separate with commas"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                </MudGrid>

                <MudButton Variant="Variant.Text" Size="Size.Small" Class="mt-2"
                           EndIcon="@(_moreOpen ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                           OnClick="() => _moreOpen = !_moreOpen" aria-expanded="@(_moreOpen ? "true" : "false")">
                    Cover and size
                </MudButton>
                @if (_moreOpen)
                {
                    <MudGrid Spacing="2" Class="mt-1">
                        <MudItem xs="12">
                            <MudTextField T="string" Value="_model.CoverUrl" ValueChanged="OnCoverUrlChangedAsync" Label="Cover image URL"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                                          HelperText="Filled in by Open Library; you can paste a link to another image" />
                        </MudItem>
                        <MudItem xs="4">
                            <MudNumericField T="int?" @bind-Value="_model.HeightMm" Label="Height (mm)" Min="1" HideSpinButtons="true"
                                             Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="4">
                            <MudNumericField T="int?" @bind-Value="_model.WidthMm" Label="Width (mm)" Min="1" HideSpinButtons="true"
                                             Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="4">
                            <MudNumericField T="int?" @bind-Value="_model.ThicknessMm" Label="Thickness (mm)" Min="1" HideSpinButtons="true"
                                             Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                Leave sizes empty to estimate them from the page count and format.
                            </MudText>
                        </MudItem>
                    </MudGrid>
                }

                @* ---------- Your copy ---------- *@
                <MudText Typo="Typo.subtitle2" Class="bm-editor__section">Your copy</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="6">
                        <MudSelect T="OwnershipStatus" @bind-Value="_model.Status" Label="Status" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                            <MudSelectItem Value="OwnershipStatus.Owned">Owned</MudSelectItem>
                            <MudSelectItem Value="OwnershipStatus.Wishlist">Wishlist</MudSelectItem>
                            <MudSelectItem Value="OwnershipStatus.LentOut">Lent out</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="6">
                        <MudSelect T="BookFormat" @bind-Value="_model.Format" Label="Format" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                            <MudSelectItem Value="BookFormat.Hardcover">Hardcover</MudSelectItem>
                            <MudSelectItem Value="BookFormat.Paperback">Paperback</MudSelectItem>
                            <MudSelectItem Value="BookFormat.MassMarketPaperback">Mass-market paperback</MudSelectItem>
                            <MudSelectItem Value="BookFormat.LeatherBound">Leather-bound</MudSelectItem>
                            <MudSelectItem Value="BookFormat.Other">Other</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    @if (_model.Status == OwnershipStatus.LentOut)
                    {
                        <MudItem xs="12">
                            <MudTextField T="string" @bind-Value="_model.LentTo" Label="Lent to" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                    }
                    @if (IsNew)
                    {
                        <MudItem xs="12" sm="6">
                            <MudSelect T="InitialReadState" @bind-Value="_model.ReadState" Label="Have you read it?" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                <MudSelectItem Value="InitialReadState.Unread">Not yet</MudSelectItem>
                                <MudSelectItem Value="InitialReadState.Reading">Reading it now</MudSelectItem>
                                <MudSelectItem Value="InitialReadState.Read">Yes, I've read it</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                    }
                    <MudItem xs="12" sm="6" Class="d-flex align-center gap-4 flex-wrap">
                        <MudRating @bind-SelectedValue="_model.RatingStars" Color="Color.Tertiary" aria-label="Rating" />
                        <MudSwitch T="bool" @bind-Value="_model.WantToReread" Label="Want to re-read" Color="Color.Primary" />
                    </MudItem>
                </MudGrid>

                @* ---------- How it looks on a shelf (placing it on shelves is separate since Phase 6b) ---------- *@
                <MudText Typo="Typo.subtitle2" Class="bm-editor__section">Look on the shelf</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="6">
                        <MudSelect T="SpineStyleChoice" @bind-Value="_model.Style" Label="Spine style" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                            <MudSelectItem Value="SpineStyleChoice.Automatic">Automatic (by format)</MudSelectItem>
                            <MudSelectItem Value="SpineStyleChoice.Classic">Classic</MudSelectItem>
                            <MudSelectItem Value="SpineStyleChoice.Banded">Banded</MudSelectItem>
                            <MudSelectItem Value="SpineStyleChoice.Ornate">Ornate</MudSelectItem>
                            <MudSelectItem Value="SpineStyleChoice.Minimal">Minimal</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12">
                        <div class="d-flex align-center gap-2 mb-1">
                            <MudText Typo="Typo.caption">Spine color @(SpineFollowsCover ? "· from the cover" : "")</MudText>
                            @if (CanUseCoverColor)
                            {
                                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="UseCoverColorForSpine">
                                    <span class="bm-editor__swatch" style="@CoverSwatchStyle"></span>Use cover color
                                </MudButton>
                            }
                        </div>
                        <SpineColorPicker @bind-Value="_model.SpineColor" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Class="d-block mb-1">
                            Text color @TextColorNote
                        </MudText>
                        <SpineColorPicker @bind-Value="_model.TextColor" Palette="BookEditModel.TextPalette" AllowAutomatic="true"
                                          Label="Text color" FallbackColor="#FFFFFF" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudSwitch T="bool" @bind-Value="_model.FaceOut" Label="Show the cover by default (each shelf can differ)" Color="Color.Primary" />
                    </MudItem>
                </MudGrid>
            </div>

            @* ---------- Live preview ---------- *@
            <div class="bm-editor__preview">
                @if (_model.CoverUrl is { } cover)
                {
                    <div class="bm-editor__cover">
                        <CoverImage Url="@cover" Size="CoverSize.Medium" Alt="Cover" Class="bm-editor__cover-img" Eager="true">
                            <Fallback>
                                <div class="bm-editor__cover-missing">Cover unavailable</div>
                            </Fallback>
                        </CoverImage>
                        <MudTooltip Text="Remove cover">
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Class="bm-editor__cover-remove"
                                           aria-label="Remove cover" OnClick="RemoveCover" />
                        </MudTooltip>
                    </div>
                }
                <div class="bm-editor__cover-actions">
                    <MudTooltip Text="@ChooseCoverTooltip">
                        <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.PhotoLibrary"
                                   OnClick="ChooseCoverAsync" Disabled="@(!CanChooseCover)">@ChooseCoverLabel</MudButton>
                    </MudTooltip>
                </div>
                <div class="bm-editor__stage" aria-hidden="true">
                    <BookSpine Book="Preview" Scale="PreviewScale" />
                </div>
                <div class="bm-editor__plank"></div>
                <MudText Typo="Typo.caption" Align="Align.Center" Class="mt-1">Preview</MudText>
            </div>
        </div>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@(!_model.IsValid || _saving)">
            @(IsNew ? "Add to library" : "Save")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private const double PreviewScale = 0.75;

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>The copy to edit; null adds a new book.</summary>
    [Parameter] public Guid? ItemId { get; set; }

    private BookEditModel _model = BookEditModel.ForNew();

    private LibraryEntry? _entry;
    private bool _saving;

    // Lookup (Phase 5)
    private string? _initialQuery;
    private BookLookupResult? _lastLookup;
    private string? _lookupSummary;
    private bool _replaced;
    private bool _moreOpen;
    private string? _colorPendingFor;
    private BookFinder? _finder;
    private string? _autoLookupIsbn;

    // The ISBN of the book the form currently shows: the one it was opened with, or the last one filled in from a
    // lookup. A lookup with a different ISBN is a different book and replaces every book detail.
    private string? _bookIsbn;

    private bool IsNew => _entry is null;

    protected override void OnInitialized()
    {
        _entry = ItemId is { } id ? LibraryData.Find(id) : null;
        _model = _entry is not null ? BookEditModel.FromEntry(_entry) : BookEditModel.ForNew();

        // Editing: offer a lookup of this book (by ISBN when it has a valid one).
        if (_entry is not null)
        {
            _initialQuery = Isbn.TryNormalize(_model.Isbn13, out var isbn)
                ? _autoLookupIsbn = _bookIsbn = isbn
                : $"{_model.Title} {BookEditModel.SplitList(_model.AuthorsText).FirstOrDefault()}".Trim();
        }

        _moreOpen = _model.HeightMm is not null || _model.WidthMm is not null || _model.ThicknessMm is not null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // A cover without an extracted color (e.g. added before color extraction existed).
        if (firstRender)
        {
            await RefreshCoverColorAsync();
        }
    }

    // Only once it's ISBN length, so it doesn't flag while the user is still typing.
    private bool IsbnInvalid => (_model.Isbn13?.Count(char.IsAsciiDigit) ?? 0) >= 10 && !Isbn.TryNormalize(_model.Isbn13, out _);

    private string TextColorNote
    {
        get
        {
            if (_model.TextColor is null)
            {
                return "· automatic";
            }

            var contrast = ColorUtil.ContrastRatio(_model.TextColor, _model.SpineColor);
            return contrast < ColorUtil.MinimumCustomContrast ? "· too close to the spine color, so automatic is used"
                : contrast < ColorUtil.ComfortableContrast ? "· may be hard to read"
                : "";
        }
    }

    /// <summary>A complete, valid ISBN typed into the ISBN field is looked up straight away, like picking a search result.</summary>
    private async Task OnIsbnChangedAsync(string? value)
    {
        _model.Isbn13 = value;
        if (!Isbn.TryNormalize(value, out var isbn) || isbn == _autoLookupIsbn || _finder is null)
        {
            return;
        }

        // Part-way through typing a 13-digit ISBN, the first 10 digits can happen to form a valid ISBN-10.
        var digits = new string(value!.Where(c => char.IsAsciiDigit(c) || c is 'X' or 'x').ToArray());
        if (digits.Length == 10 && (digits.StartsWith("978", StringComparison.Ordinal) || digits.StartsWith("979", StringComparison.Ordinal)))
        {
            return;
        }

        _autoLookupIsbn = isbn;
        await _finder.FindAsync(isbn);
    }

    private bool SpineFollowsCover => _model.DominantColor is not null
        && string.Equals(_model.SpineColor, _model.DominantColor, StringComparison.OrdinalIgnoreCase);

    private bool CanUseCoverColor => _model.DominantColor is not null && !SpineFollowsCover;

    private string CoverSwatchStyle => $"background:{_model.DominantColor}";

    private async Task ApplyLookupAsync(BookLookupResult result)
    {
        var mode = LookupMerge.ModeFor(_bookIsbn, result);
        _lastLookup = result;
        _replaced = mode == LookupApplyMode.ReplaceBook; // nothing more to replace
        var changed = LookupMerge.Apply(_model, result, mode, IsNew);
        if (Isbn.TryNormalize(result.Isbn13, out var isbn))
        {
            _bookIsbn = isbn;
        }

        _lookupSummary = mode == LookupApplyMode.ReplaceBook
            ? $"Replaced the book details with “{result.Title}” from Open Library."
            : changed.Count == 0
                ? "Open Library had nothing new to add."
                : $"{LookupMerge.Describe(changed)} from Open Library.";
        StateHasChanged();
        await RefreshCoverColorAsync();
    }

    private async Task ReplaceAllAsync()
    {
        if (_lastLookup is null)
        {
            return;
        }

        var changed = LookupMerge.Apply(_model, _lastLookup, LookupApplyMode.ReplaceAll, IsNew);
        _replaced = true;
        _lookupSummary = changed.Count == 0
            ? "Already matches Open Library."
            : $"{LookupMerge.Describe(changed)} from Open Library.";
        await RefreshCoverColorAsync();
    }

    /// <summary>A scanned barcode is this copy's ISBN, so it replaces whatever was there.</summary>
    private void UseScannedIsbn(string isbn)
    {
        _model.Isbn13 = isbn;
        _autoLookupIsbn = isbn; // the finder looks it up; don't repeat that from the ISBN field
    }

    private void KeepIsbn(string isbn)
    {
        if (string.IsNullOrWhiteSpace(_model.Isbn13))
        {
            _model.Isbn13 = isbn;
        }
    }

    private async Task OnCoverUrlChangedAsync(string? value)
    {
        var url = CoverUrls.Normalize(value);
        if (url is not null && !(Uri.TryCreate(url, UriKind.Absolute, out var uri) && uri.Scheme == Uri.UriSchemeHttps))
        {
            // Only https images: http would be blocked as mixed content anyway.
            return;
        }

        if (url is null)
        {
            RemoveCover();
            return;
        }

        if (!string.Equals(url, _model.CoverUrl, StringComparison.Ordinal))
        {
            _model.CoverUrl = url;
            _model.DominantColor = null;
            await RefreshCoverColorAsync();
        }
    }

    private void RemoveCover() => _model.RemoveCover();

    private bool CanChooseCover => AppStatus.IsOnline
        && (Isbn.TryNormalize(_model.Isbn13, out _) || !string.IsNullOrWhiteSpace(_model.Title));

    private string ChooseCoverLabel => _model.CoverUrl is null ? "Find a cover" : "Change cover";

    private string ChooseCoverTooltip => !AppStatus.IsOnline ? "Choosing a cover needs a connection"
        : CanChooseCover ? "Choose from this book's covers on Open Library"
        : "Enter an ISBN or title first";

    /// <summary>Lets the user pick another Open Library cover; only the cover (and its color) changes.</summary>
    private async Task ChooseCoverAsync()
    {
        var isbn = Isbn.TryNormalize(_model.Isbn13, out var normalized) ? normalized : null;
        var parameters = new DialogParameters
        {
            { nameof(CoverPickerDialog.Isbn13), isbn },
            { nameof(CoverPickerDialog.Title), _model.Title },
            { nameof(CoverPickerDialog.Author), BookEditModel.SplitList(_model.AuthorsText).FirstOrDefault() },
            { nameof(CoverPickerDialog.CurrentCoverUrl), _model.CoverUrl },
        };
        var options = await DialogDefaults.EditorAsync(Viewport, MaxWidth.Medium);
        var dialog = await Dialogs.ShowAsync<CoverPickerDialog>(null, parameters, options);
        if (await dialog.Result is not { Canceled: false, Data: string url } || string.Equals(url, _model.CoverUrl, StringComparison.Ordinal))
        {
            return;
        }

        _model.CoverUrl = url;
        _model.DominantColor = null;
        StateHasChanged();
        await RefreshCoverColorAsync();
    }

    private void UseCoverColorForSpine()
    {
        _model.SpineColor = _model.DominantColor;
        _model.SpineColorFollowsCover = true; // stored as "no override", so it keeps following the cover
        _model.EnsureReadableText();
    }

    /// <summary>Extracts the cover's color when there's a cover without one. Stale results are ignored.</summary>
    private async Task RefreshCoverColorAsync()
    {
        var url = _model.CoverUrl;
        if (url is null || _model.DominantColor is not null || url == _colorPendingFor)
        {
            return;
        }

        _colorPendingFor = url;
        try
        {
            var hex = await CoverColors.DominantColorAsync(url);
            if (hex is not null && string.Equals(url, _model.CoverUrl, StringComparison.Ordinal))
            {
                _model.UseCoverColor(hex);
                StateHasChanged();
            }
        }
        finally
        {
            _colorPendingFor = null;
        }
    }

    /// <summary>The book as it would look with the current form values.</summary>
    private PlacedBook Preview
    {
        get
        {
            var book = new Book();
            var item = new LibraryItem();
            _model.ApplyTo(book, item);
            if (string.IsNullOrWhiteSpace(book.Title))
            {
                book.Title = "Title";
            }

            if (_entry is not null)
            {
                // Per-copy size overrides aren't edited here; keep them so the preview matches the shelf.
                item.Appearance.HeightMmOverride = _entry.Item.Appearance.HeightMmOverride;
                item.Appearance.ThicknessMmOverride = _entry.Item.Appearance.ThicknessMmOverride;
            }

            var entry = LibraryEntry.Create(item, book, Array.Empty<ReadingSession>());
            return ShelfLayoutEngine.Flow(new[] { entry }, int.MaxValue)[0].Books[0];
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        if (!_model.IsValid || _saving)
        {
            return;
        }

        _saving = true;
        try
        {
            Guid id;
            if (_entry is not null)
            {
                await LibraryData.UpdateBookAsync(_entry.Id, _model);
                id = _entry.Id;
            }
            else
            {
                id = await LibraryData.AddBookAsync(_model);
            }

            MudDialog.Close(DialogResult.Ok(id));
        }
        finally
        {
            _saving = false;
        }
    }
}
