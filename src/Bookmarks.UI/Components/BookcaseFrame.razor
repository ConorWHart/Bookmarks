@* Wraps shelves in a themed bookcase (side panels, top, colors via CSS variables). *@

<section class="bm-case bm-case--@Theme" style="@CustomStyle">
    @if (!string.IsNullOrEmpty(Title))
    {
        <header class="bm-case__title">
            <span class="bm-case__plate">
                <span class="bm-case__name">@Title</span>
                @if (!string.IsNullOrEmpty(Subtitle))
                {
                    <span class="bm-case__count">@Subtitle</span>
                }
            </span>
        </header>
    }
    <div class="bm-case__body">
        @ChildContent
    </div>
</section>

@code {
    [Parameter] public string? Title { get; set; }

    /// <summary>A second, smaller line on the name plate (the book count).</summary>
    [Parameter] public string? Subtitle { get; set; }

    /// <summary>oak | walnut | white | dark</summary>
    [Parameter] public string Theme { get; set; } = "oak";

    /// <summary>A colour of the user's own (Phase 6d): replaces the finish's wood colours; the name plate stays.</summary>
    [Parameter] public string? CustomColor { get; set; }

    private string? CustomStyle => ColorUtil.BookcasePaletteFor(CustomColor) is { } p
        ? $"--bm-wood-hi:{p.Highlight};--bm-wood:{p.Wood};--bm-wood-lo:{p.Shadow};--bm-case-back:{p.Back};--bm-case-label:{p.Label};"
        : null;

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
