@* Wraps shelves in a themed bookcase (side panels, top, colors via CSS variables). *@

<section class="bm-case bm-case--@Theme">
    @if (!string.IsNullOrEmpty(Title))
    {
        <header class="bm-case__title"><span class="bm-case__plate">@Title</span></header>
    }
    <div class="bm-case__body">
        @ChildContent
    </div>
</section>

@code {
    [Parameter] public string? Title { get; set; }

    /// <summary>oak | walnut | white | dark</summary>
    [Parameter] public string Theme { get; set; } = "oak";

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
