@* The selected book: details, rating, reading log and notes. Editing the book itself happens in BookEditorDialog.
   A side drawer on wider screens; on phones a bottom sheet (Phase 8c) with a grab handle to swipe it down. Reading
   and notes come before the shelf settings, since they're what you open a book for most. *@
@inject LibraryService LibraryData
@inject IDialogService Dialogs
@inject IBrowserViewportService Viewport

@if (Entry is not null)
{
    var entry = Entry;
    var sessions = LibraryData.SessionsFor(entry.Id);
    var notes = LibraryData.NotesFor(entry.Id);

    @if (IsSheet)
    {
        @* Swipe down here to close (Back, ✕ and tapping above the sheet close it too). *@
        <div class="bm-details__grab" @ontouchstart="GrabStart" @ontouchend="GrabEndAsync" aria-hidden="true">
            <span class="bm-details__grab-bar"></span>
        </div>
    }

    <div class="@(IsSheet ? "px-4 pb-4 pt-1 bm-details" : "pa-4 bm-details")">
        <div class="d-flex align-start">
            @* Every book gets a picture: its cover, or one drawn in its colours like the covers grid (Phase 8c). *@
            <div class="bm-details__cover">
                @if (entry.Book.CoverUrl is { } cover)
                {
                    <CoverImage Url="@cover" Size="CoverSize.Medium" Alt="@CoverAlt(entry)" Class="bm-details__cover-img" Eager="true" />
                }
                else
                {
                    <div class="bm-details__drawn" style="@DrawnStyle(entry)" role="img" aria-label="@CoverAlt(entry)">
                        <span class="bm-details__drawn-title">@entry.Title</span>
                        <span class="bm-details__drawn-author">@entry.Author</span>
                    </div>
                }
            </div>
            <div class="flex-grow-1">
                <MudText Typo="Typo.h5">@entry.Title</MudText>
                @if (!string.IsNullOrEmpty(entry.Book.Subtitle))
                {
                    <MudText Typo="Typo.subtitle1">@entry.Book.Subtitle</MudText>
                }
                <MudText Typo="Typo.body1">@string.Join(", ", entry.Book.Authors)</MudText>
                @if (entry.Book.Series is not null)
                {
                    <MudText Typo="Typo.body2" Class="mt-1">@SeriesText(entry)</MudText>
                }
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="OnClose" aria-label="Close details" />
        </div>

        @* Edit is in the footer (thumb reach); Delete stays up here, away from it. *@
        <MudStack Row="true" Spacing="1" Class="my-3" AlignItems="AlignItems.Center">
            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                       StartIcon="@Icons.Material.Outlined.Delete" OnClick="() => OnDelete.InvokeAsync(entry)">Delete</MudButton>
        </MudStack>

        <MudStack Row="true" Spacing="1" Class="mb-2" Wrap="Wrap.Wrap">
            <MudChip T="string" Size="Size.Small" Color="Color.Primary">@StatusText(entry)</MudChip>
            <MudChip T="string" Size="Size.Small">@FormatText(entry.Item.Format)</MudChip>
            @foreach (var genre in entry.Book.Genres)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@genre</MudChip>
            }
        </MudStack>

        <div class="d-flex align-center flex-wrap gap-3">
            <MudRating SelectedValue="Stars(entry)" SelectedValueChanged="SetRatingAsync" Color="Color.Tertiary" aria-label="Rating" />
            <MudSwitch T="bool" Value="entry.Item.WantToReread" ValueChanged="SetRereadAsync" Label="Want to re-read" Color="Color.Secondary" />
        </div>

        @* ---------- Reading log ---------- *@
        <MudDivider Class="my-4" />
        <div class="d-flex align-baseline">
            <MudText Typo="Typo.subtitle1" Class="flex-grow-1">Reading</MudText>
            <MudText Typo="Typo.caption">@ReadSummary(entry)</MudText>
        </div>

        <MudStack Row="true" Spacing="1" Class="my-2" Wrap="Wrap.Wrap">
            @if (entry.IsReading)
            {
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Check"
                           OnClick="() => FinishAsync(entry, sessions, ReadingOutcome.Finished)">Finished it</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Text"
                           OnClick="() => FinishAsync(entry, sessions, ReadingOutcome.Abandoned)">Stopped reading</MudButton>
            }
            else
            {
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AutoStories"
                           OnClick="() => LibraryData.StartReadingAsync(entry.Id)">Start reading</MudButton>
            }
            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.History"
                       OnClick="() => EditSessionAsync(null)">Log a read</MudButton>
        </MudStack>

        @if (sessions.Count == 0)
        {
            <MudText Typo="Typo.caption" Class="d-block">No reads logged yet.</MudText>
        }
        @foreach (var session in _readsExpanded ? sessions : sessions.Take(CollapsedReads))
        {
            <div class="bm-details__row" @key="session.Id">
                <MudIcon Icon="@OutcomeIcon(session.Outcome)" Size="Size.Small" Color="@OutcomeColor(session.Outcome)" />
                <div class="flex-grow-1">
                    <MudText Typo="Typo.body2">@SessionDates(session)</MudText>
                    <MudText Typo="Typo.caption">@OutcomeText(session.Outcome)@PagesLoggedText(session)</MudText>
                </div>
                <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" aria-label="Edit read"
                               OnClick="() => EditSessionAsync(session)" />
                <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" aria-label="Delete read"
                               OnClick="() => LibraryData.DeleteSessionAsync(session.Id)" />
            </div>
        }

        @if (sessions.Count > CollapsedReads)
        {
            @* More than 3 reads: only the most recent 3 until expanded (always starts collapsed, not remembered). *@
            <div class="d-flex justify-center mt-1">
                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                           EndIcon="@(_readsExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                           aria-expanded="@(_readsExpanded ? "true" : "false")"
                           OnClick="() => _readsExpanded = !_readsExpanded">@ReadsToggleText(sessions.Count)</MudButton>
            </div>
        }

        @* ---------- Notes ---------- *@
        <MudDivider Class="my-4" />
        <MudText Typo="Typo.subtitle1" Class="mb-2">Notes</MudText>

        <MudTextField T="string" @bind-Value="_newNote" Placeholder="Add a note…" Lines="2" Sizing="InputSizing.Auto" MaxLines="10"
                      Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
        <div class="d-flex justify-end mt-1 mb-2">
            <MudButton Size="Size.Small" Color="Color.Primary" Disabled="string.IsNullOrWhiteSpace(_newNote)"
                       OnClick="() => AddNoteAsync(entry.Id)">Add note</MudButton>
        </div>

        @foreach (var note in notes)
        {
            <div class="bm-details__note" @key="note.Id">
                @if (_editingNoteId == note.Id)
                {
                    <MudTextField T="string" @bind-Value="_editText" Lines="2" Sizing="InputSizing.Auto" MaxLines="10"
                                  Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" AutoFocus="true" />
                    <div class="d-flex justify-end gap-1 mt-1">
                        <MudButton Size="Size.Small" OnClick="() => _editingNoteId = null">Cancel</MudButton>
                        <MudButton Size="Size.Small" Color="Color.Primary" Disabled="string.IsNullOrWhiteSpace(_editText)"
                                   OnClick="() => SaveNoteAsync(note.Id)">Save</MudButton>
                    </div>
                }
                else
                {
                    <div class="bm-details__note-body">@note.Body</div>
                    <div class="d-flex align-center">
                        <MudText Typo="Typo.caption" Class="flex-grow-1">@note.CreatedAt.ToLocalTime().ToString("d MMM yyyy")</MudText>
                        <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" aria-label="Edit note"
                                       OnClick="() => BeginEditNote(note)" />
                        <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" aria-label="Delete note"
                                       OnClick="() => LibraryData.DeleteNoteAsync(note.Id)" />
                    </div>
                }
            </div>
        }

        @* ---------- On shelves (Phase 6b: any number of bookcases, once each; below reading and notes since 8c) ---------- *@
        <MudDivider Class="my-4" />
        @{ var places = LibraryData.PlacesOf(entry.Id); }
        <div class="d-flex align-center">
            <MudText Typo="Typo.subtitle1" Class="flex-grow-1">On shelves</MudText>
            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       Disabled="@(LibraryData.Bookcases.Count == 0)" OnClick="() => PutOnShelfAsync(entry)">Put on a shelf…</MudButton>
        </div>
        @if (places.Count == 0)
        {
            <MudText Typo="Typo.caption" Class="d-block">
                @(LibraryData.Bookcases.Count == 0 ? "Set up a bookcase to put books on shelves." : "Not on a shelf yet.")
            </MudText>
        }
        @foreach (var place in places)
        {
            @* One card per bookcase: name and "take off" on top; below, which shelf, where along it, and spine or cover. *@
            <div class="bm-place" @key="place.Placement.Id">
                <div class="bm-place__head">
                    <span class="bm-place__case">@place.Bookcase.Name</span>
                    @if (place.Bookcase.IsHidden)
                    {
                        <span class="bm-place__tag">Hidden</span>
                    }
                    <span class="bm-place__remove">
                        <MudTooltip Text="Take off this shelf">
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                           OnClick="() => LibraryData.RemovePlacementAsync(place.Placement.Id)"
                                           aria-label="@($"Take off {place.Bookcase.Name}")" />
                        </MudTooltip>
                    </span>
                </div>

                <div class="bm-place__controls">
                    <div class="bm-place__shelf">
                        <MudSelect T="Guid" Value="place.Shelf.Id" ValueChanged="(Guid shelfId) => ChangeShelfAsync(entry, place, shelfId)"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                            @foreach (var shelf in LibraryData.ShelvesIn(place.Bookcase.Id))
                            {
                                <MudSelectItem Value="shelf.Id">@LibraryData.ShelfLabel(shelf)</MudSelectItem>
                            }
                        </MudSelect>
                    </div>

                    <div class="bm-place__pos" role="group" aria-label="Position on the shelf">
                        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" Disabled="!CanMove(entry, place, -1)"
                                       OnClick="() => LibraryData.MovePlacementAsync(place.Placement.Id, -1)" aria-label="Move left on this shelf" />
                        <span class="bm-place__pos-text" title="Position from the left">@PositionText(entry, place)</span>
                        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Disabled="!CanMove(entry, place, 1)"
                                       OnClick="() => LibraryData.MovePlacementAsync(place.Placement.Id, 1)" aria-label="Move right on this shelf" />
                    </div>

                    <div class="bm-place__face">
                        <MudToggleGroup T="bool" Value="LibraryData.IsFaceOut(place.Placement)"
                                        ValueChanged="(bool v) => LibraryData.SetPlacementFaceOutAsync(place.Placement.Id, v)"
                                        Color="Color.Primary" Size="Size.Small" Outlined="true" aria-label="Show on this shelf by">
                            <MudToggleItem Value="false" Text="Spine" />
                            <MudToggleItem Value="true" Text="Cover" />
                        </MudToggleGroup>
                    </div>
                </div>
            </div>
        }

        @* ---------- Details ---------- *@
        <MudDivider Class="my-4" />
        <MudSimpleTable Dense="true" Elevation="0">
            <tbody>
                <tr><td>Pages</td><td>@(entry.Book.PageCount?.ToString() ?? "—")</td></tr>
                @if (entry.Book.Publisher is not null || entry.Book.PublishedYear is not null)
                {
                    <tr><td>Published</td><td>@PublishedText(entry.Book)</td></tr>
                }
                @if (entry.Book.Isbn13 is not null)
                {
                    <tr><td>ISBN</td><td>@entry.Book.Isbn13</td></tr>
                }
                <tr><td>Added</td><td>@entry.Item.AddedAt.ToLocalTime().ToString("d MMM yyyy")</td></tr>
            </tbody>
        </MudSimpleTable>
    </div>

    @* Stays at the bottom of the drawer while the details scroll. *@
    <div class="bm-details__foot">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" StartIcon="@Icons.Material.Filled.Edit"
                   OnClick="() => OnEdit.InvokeAsync(entry)">Edit book</MudButton>
    </div>
}

@code {
    private static string CoverAlt(LibraryEntry e) => "Cover of " + e.Title;

    [Parameter] public LibraryEntry? Entry { get; set; }

    [Parameter] public EventCallback<LibraryEntry> OnEdit { get; set; }

    [Parameter] public EventCallback<LibraryEntry> OnDelete { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Shown as a bottom sheet (phones): adds the grab handle.</summary>
    [Parameter] public bool IsSheet { get; set; }

    private double? _grabY;

    private void GrabStart(TouchEventArgs e) => _grabY = e.Touches.Length > 0 ? e.Touches[0].ClientY : null;

    /// <summary>A downward swipe of 60px or more on the handle closes the sheet.</summary>
    private async Task GrabEndAsync(TouchEventArgs e)
    {
        if (_grabY is { } start && e.ChangedTouches.Length > 0 && e.ChangedTouches[0].ClientY - start >= 60)
        {
            await OnClose.InvokeAsync();
        }

        _grabY = null;
    }

    private static string DrawnStyle(LibraryEntry e)
    {
        var fg = ColorUtil.SpineTextColor(e.SpineColor, e.Item.Appearance.TextColor, ornate: false);
        return $"--bm-book-bg:{e.SpineColor};--bm-book-fg:{fg};--bm-book-emboss:{ColorUtil.EmbossShadow(fg)};";
    }

    private Guid? _shownId;

    /// <summary>Reads shown before "Show all" (newest first).</summary>
    private const int CollapsedReads = 3;

    private bool _readsExpanded;

    /// <summary>Whether the drawer/sheet is open: reopening it starts the reads collapsed again, even for the same book.</summary>
    [Parameter] public bool IsOpen { get; set; } = true;

    private bool _wasOpen;

    private string ReadsToggleText(int count) => _readsExpanded ? "Show fewer" : $"Show all {count} reads";

    private string? _newNote;
    private Guid? _editingNoteId;
    private string? _editText;

    protected override void OnParametersSet()
    {
        // Switching books discards half-typed notes.
        if (Entry?.Id != _shownId)
        {
            _shownId = Entry?.Id;
            _newNote = null;
            _editingNoteId = null;
            _readsExpanded = false; // each book starts with its reads collapsed
        }

        if (IsOpen && !_wasOpen)
        {
            _readsExpanded = false; // and so does every opening, even of the same book
        }

        _wasOpen = IsOpen;
    }

    private Task SetRatingAsync(int stars)
        => Entry is null ? Task.CompletedTask : LibraryData.SetRatingAsync(Entry.Id, stars == 0 ? null : stars);


    /// <summary>Opens the shelf picker with this book chosen.</summary>
    private Task PutOnShelfAsync(LibraryEntry entry) => ShelfPickerDialog.OpenAsync(Dialogs, Viewport, [entry.Id]);

    private Task SetRereadAsync(bool value)
        => Entry is null ? Task.CompletedTask : LibraryData.SetWantToRereadAsync(Entry.Id, value);

    /// <summary>Finished it / Stopped reading: asks for the day and that day's pages, then closes the latest read in progress.</summary>
    private Task FinishAsync(LibraryEntry entry, IEnumerable<ReadingSession> sessions, ReadingOutcome outcome)
    {
        var current = sessions
            .Where(s => s.Outcome == ReadingOutcome.InProgress)
            .OrderByDescending(s => s.StartedOn ?? DateOnly.MinValue)
            .FirstOrDefault();
        return current is null
            ? LibraryData.FinishReadingAsync(entry.Id, outcome)
            : FinishReadSheet.OpenAsync(Dialogs, LibraryData, entry, current, outcome);
    }

    private async Task EditSessionAsync(ReadingSession? existing)
    {
        if (Entry is null)
        {
            return;
        }

        var copy = existing is null
            ? new ReadingSession
            {
                LibraryItemId = Entry.Id,
                Outcome = ReadingOutcome.InProgress,
                StartedOn = DateOnly.FromDateTime(DateTime.Today),
            }
            : Clone(existing);

        var parameters = new DialogParameters
        {
            { nameof(ReadingSessionDialog.Session), copy },
            { nameof(ReadingSessionDialog.IsNew), existing is null },
            { nameof(ReadingSessionDialog.PageCount), Entry.Book.PageCount },
        };
        // A bottom sheet like Finished it / Stopped reading: tapping outside closes it without saving.
        var dialog = await Dialogs.ShowAsync<ReadingSessionDialog>(parameters, DialogDefaults.Sheet());
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: ReadingSession saved })
        {
            await LibraryData.SaveSessionAsync(saved);
        }
    }

    private async Task AddNoteAsync(Guid itemId)
    {
        var body = _newNote;
        _newNote = null;
        await LibraryData.AddNoteAsync(itemId, body ?? "");
    }

    private void BeginEditNote(Note note)
    {
        _editingNoteId = note.Id;
        _editText = note.Body;
    }

    private async Task SaveNoteAsync(Guid noteId)
    {
        _editingNoteId = null;
        await LibraryData.UpdateNoteAsync(noteId, _editText ?? "");
    }

    /// <summary>Dialogs edit a copy so Cancel leaves the cached record untouched. Keeps sync fields.</summary>
    private static ReadingSession Clone(ReadingSession s) => new()
    {
        Id = s.Id,
        UserId = s.UserId,
        UpdatedAt = s.UpdatedAt,
        Version = s.Version,
        IsDeleted = s.IsDeleted,
        LibraryItemId = s.LibraryItemId,
        StartedOn = s.StartedOn,
        FinishedOn = s.FinishedOn,
        Outcome = s.Outcome,
        Rating = s.Rating,
        PageLog = [.. s.PageLog],
    };

    private static string PagesLoggedText(ReadingSession s)
        => s.PageLog.Sum(d => d.Pages) is var pages and > 0 ? $" · {pages} {(pages == 1 ? "page" : "pages")} logged" : "";

    private static int Stars(LibraryEntry e) => (int)Math.Round(e.Item.Rating ?? 0, MidpointRounding.AwayFromZero);

    private static string SeriesText(LibraryEntry e) => e.Book.SeriesNumber is { } n
        ? $"{e.Book.Series} #{n:0.#}"
        : e.Book.Series ?? "";

    private static string StatusText(LibraryEntry e) => e.Item.Status switch
    {
        OwnershipStatus.Wishlist => "Wishlist",
        OwnershipStatus.LentOut => e.Item.LentTo is { } who ? $"Lent to {who}" : "Lent out",
        _ => "Owned",
    };

    private static string FormatText(BookFormat f) => f switch
    {
        BookFormat.MassMarketPaperback => "Mass-market paperback",
        BookFormat.LeatherBound => "Leather-bound",
        _ => f.ToString(),
    };

    private static string ReadSummary(LibraryEntry e) => e.ReadCount switch
    {
        0 => e.IsReading ? "Reading now" : "Not read yet",
        1 => "Read once" + LastFinished(e),
        var n => $"Read {n} times" + LastFinished(e),
    };

    private static string LastFinished(LibraryEntry e)
        => e.LastFinishedOn is { } d ? $" · last {d:MMM yyyy}" : "";

    private static string SessionDates(ReadingSession s) => (s.StartedOn, s.FinishedOn) switch
    {
        ({ } start, { } end) when start == end => $"{end:d MMM yyyy}", // started and finished the same day
        ({ } start, { } end) => $"{start:d MMM yyyy} – {end:d MMM yyyy}",
        ({ } start, null) => $"Started {start:d MMM yyyy}",
        (null, { } end) => $"Finished {end:d MMM yyyy}",
        _ => "Dates unknown",
    };

    private static string OutcomeText(ReadingOutcome o) => o switch
    {
        ReadingOutcome.InProgress => "Reading",
        ReadingOutcome.Abandoned => "Didn't finish",
        _ => "Finished",
    };

    private static string OutcomeIcon(ReadingOutcome o) => o switch
    {
        ReadingOutcome.InProgress => Icons.Material.Filled.AutoStories,
        ReadingOutcome.Abandoned => Icons.Material.Filled.DoNotDisturbOn,
        _ => Icons.Material.Filled.CheckCircle,
    };

    private static Color OutcomeColor(ReadingOutcome o) => o switch
    {
        ReadingOutcome.InProgress => Color.Info,
        ReadingOutcome.Abandoned => Color.Default,
        _ => Color.Success,
    };

    private static string PublishedText(Book b)
        => string.Join(", ", new[] { b.Publisher, b.PublishedYear?.ToString() }.Where(s => !string.IsNullOrEmpty(s)));

    /// <summary>Moves the book to another shelf of the same bookcase (to the end of it).</summary>
    private async Task ChangeShelfAsync(LibraryEntry entry, BookPlace place, Guid shelfId)
    {
        if (shelfId != place.Shelf.Id)
        {
            await LibraryData.PlaceBooksAsync([entry.Id], shelfId);
        }
    }

    /// <summary>"3 of 6" (from the left), so the arrows visibly do something.</summary>
    private string PositionText(LibraryEntry entry, BookPlace place)
    {
        var books = LibraryData.BooksOnShelf(place.Shelf.Id);
        var index = books.ToList().FindIndex(b => b.Id == entry.Id);
        return index < 0 ? "" : $"{index + 1} of {books.Count}";
    }

    /// <summary>Whether the book has a neighbour on that side of the shelf.</summary>
    private bool CanMove(LibraryEntry entry, BookPlace place, int delta)
    {
        var books = LibraryData.BooksOnShelf(place.Shelf.Id);
        var index = books.ToList().FindIndex(b => b.Id == entry.Id);
        var target = index + delta;
        return index >= 0 && target >= 0 && target < books.Count;
    }
}
