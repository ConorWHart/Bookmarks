@* How to install Bookmarks in this browser (Phase 8b): shown by the install banner's "Show me how" and in Settings. *@

<ol class="bm-install-steps">
    @switch (Platform)
    {
        case InstallPlatform.AndroidFirefox:
            <li>Tap the <strong>⋮</strong> menu next to Firefox's address bar (at the top or bottom of the screen).</li>
            <li>Tap <strong>Add app to Home screen</strong> (on some versions it's called <strong>Install</strong>).</li>
            <li>Tap <strong>Add</strong>. Bookmarks now has its own icon on your home screen: open it from there.</li>
            break;
        case InstallPlatform.AndroidChrome:
            <li>Tap the <strong>⋮</strong> menu at the top right of Chrome.</li>
            <li>Tap <strong>Add to Home screen</strong> or <strong>Install app</strong>.</li>
            <li>Tap <strong>Install</strong>. Bookmarks now has its own icon with your other apps: open it from there.</li>
            break;
        case InstallPlatform.AndroidSamsung:
            <li>Tap the <strong>≡</strong> menu at the bottom right of Samsung Internet.</li>
            <li>Tap <strong>Add page to</strong>, then <strong>Home screen</strong> (or <strong>Install</strong> if you see it).</li>
            <li>Open Bookmarks from its new icon on your home screen.</li>
            break;
        case InstallPlatform.IosSafari:
            <li>Tap the <strong>Share</strong> button (the square with an arrow) in Safari's toolbar.</li>
            <li>Scroll down and tap <strong>Add to Home Screen</strong>.</li>
            <li>Tap <strong>Add</strong>. Open Bookmarks from its new icon on your home screen.</li>
            break;
        case InstallPlatform.IosOther:
            <li>Tap the <strong>Share</strong> button (the square with an arrow), in the address bar or the browser's menu.</li>
            <li>Tap <strong>Add to Home Screen</strong>, then <strong>Add</strong>. If you don't see it, open this page in Safari and do it there.</li>
            <li>Open Bookmarks from its new icon on your home screen.</li>
            break;
        case InstallPlatform.DesktopChromium:
            <li>Click the <strong>Install</strong> icon (a screen with a down arrow) at the right end of the address bar.</li>
            <li>No icon? Open the browser's <strong>⋮</strong> or <strong>…</strong> menu and look for <strong>Install Bookmarks</strong> (in Chrome under <strong>Cast, save, and share</strong>; in Edge under <strong>Apps</strong>).</li>
            <li>Bookmarks then opens in its own window and from the Start menu or Dock.</li>
            break;
        case InstallPlatform.DesktopSafari:
            <li>In Safari's menu bar choose <strong>File</strong> → <strong>Add to Dock</strong> (macOS Sonoma or later).</li>
            <li>Open Bookmarks from the Dock.</li>
            break;
        case InstallPlatform.DesktopFirefox:
            <li>Firefox on a computer can't install apps. Open Bookmarks in Chrome or Edge to install it, or keep using it here: everything works the same.</li>
            break;
        default:
            <li>Open your browser's menu and look for <strong>Install</strong> or <strong>Add to Home screen</strong>.</li>
            <li>If there isn't one, Chrome, Edge, Firefox (on Android) and Safari (on iPhone) can all install Bookmarks.</li>
            break;
    }
</ol>

@code {
    [Parameter] public InstallPlatform Platform { get; set; }
}
