@* Camera barcode scanner. Closes with the ISBN-13 it read. *@
@implements IAsyncDisposable
@implements IBarcodeScanHandler
@inject IBarcodeScanner Scanner

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Scan a barcode</MudText>
    </TitleContent>

    <DialogContent>
        <div class="bm-scanner">
            <video @ref="_video" class="bm-scanner__video" autoplay muted playsinline></video>
            @if (_error is null)
            {
                <div class="bm-scanner__guide" aria-hidden="true"></div>
            }
            @if (_starting)
            {
                <div class="bm-scanner__status">
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Style="color:#fff" />
                    <span>Starting the camera…</span>
                </div>
            }
        </div>

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-3">@_error</MudAlert>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mt-3 mud-text-secondary" role="status">@_hint</MudText>
        }
    </DialogContent>

    <DialogActions>
        @if (_torchAvailable)
        {
            <MudTooltip Text="@TorchLabel">
                <MudIconButton Icon="@(_torchOn ? Icons.Material.Filled.FlashOff : Icons.Material.Filled.FlashOn)"
                               OnClick="ToggleTorchAsync" aria-label="Toggle the camera light" />
            </MudTooltip>
        }
        <MudSpacer />
        <MudButton OnClick="Cancel">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private const string DefaultHint = "Point the camera at the barcode on the back cover and hold it steady.";

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private ElementReference _video;
    private bool _starting = true;
    private string? _error;
    private string _hint = DefaultHint;
    private bool _torchAvailable;
    private bool _torchOn;
    private bool _closed;
    private bool _notIsbnSeen;
    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var error = await Scanner.StartAsync(_video, this);
        _starting = false;
        if (error is not null)
        {
            _error = Message(error);
        }
        else
        {
            _torchAvailable = await Scanner.TorchAvailableAsync();
            _ = ShowTipLaterAsync(_cts.Token);
        }

        StateHasChanged();
    }

    /// <summary>Most failed scans are a blurry picture: fixed-focus laptop webcams can't focus up close.</summary>
    private async Task ShowTipLaterAsync(CancellationToken ct)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(8), ct);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (!_closed && !_notIsbnSeen)
        {
            _hint = "Having trouble? Move the book a little further away so the bars look sharp, fill the box with the barcode, "
                + "and make sure it's well lit. Built-in laptop cameras often can't focus up close; you can always type the ISBN instead.";
            await InvokeAsync(StateHasChanged);
        }
    }

    public Task OnDetectedAsync(string isbn13) => InvokeAsync(() =>
    {
        if (!_closed && Isbn.TryNormalize(isbn13, out var isbn))
        {
            _closed = true;
            MudDialog.Close(DialogResult.Ok(isbn));
        }
    });

    public Task OnNotIsbnAsync() => InvokeAsync(() =>
    {
        _notIsbnSeen = true;
        _hint = "That barcode isn't an ISBN. Look for the one whose number starts with 978 or 979, usually beside the price code.";
        StateHasChanged();
    });

    private async Task ToggleTorchAsync()
    {
        if (await Scanner.SetTorchAsync(!_torchOn))
        {
            _torchOn = !_torchOn;
        }
    }

    private void Cancel()
    {
        _closed = true;
        MudDialog.Cancel();
    }

    private string TorchLabel => _torchOn ? "Turn the light off" : "Turn the light on";

    private static string Message(string error) => error switch
    {
        "denied" => "Camera access was blocked. Allow the camera for this site in your browser's settings, then try again.",
        "nocamera" => "No camera was found on this device. Type the ISBN instead.",
        "inuse" => "The camera is being used by another app. Close it and try again.",
        "unsupported" => "This browser can't use the camera here. Type the ISBN instead.",
        "nodecoder" => "The barcode reader couldn't be loaded. If you're offline, connect once so it can download.",
        _ => "Couldn't start the camera. Type the ISBN instead.",
    };

    public async ValueTask DisposeAsync()
    {
        _cts.Cancel();
        _cts.Dispose();
        await Scanner.StopAsync();
    }
}
