@using Bookmarks.Core.Storage
@implements IDisposable
@inject IAccountService Accounts
@inject ISyncService Sync
@inject ILocalLibraryEraser LocalLibrary
@inject IGuestLibraryTransfer GuestLibrary
@inject ILocalStore Store
@inject LibraryService LibraryData
@inject IAppStatusService AppStatus
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

@* No sign-in support on this host (MAUI, or no Auth configuration): show nothing. *@
@if (!Accounts.IsSignInSupported)
{
}
else if (Accounts.Current.IsGuest)
{
    <MudTooltip Text="@(AppStatus.IsOnline ? "Sign in to back up your library and keep it in sync across your devices." : "You're offline. Sign in when you're back online.")">
        <div class="bm-account">
            <MudButton StartIcon="@Icons.Material.Filled.PersonOutline" Variant="Variant.Text"
                       Disabled="@(!AppStatus.IsOnline || _busy)" OnClick="SignInAsync">Sign in</MudButton>
        </div>
    </MudTooltip>
}
else
{
    <MudMenu Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit" AnchorOrigin="Origin.BottomRight"
             TransformOrigin="Origin.TopRight" aria-label="Account">
        <MudMenuItem Disabled="true">
            <div class="bm-account__header">
                <MudText Typo="Typo.body1">@Accounts.Current.Label</MudText>
                @if (!string.IsNullOrWhiteSpace(Accounts.Current.Email) && Accounts.Current.Email != Accounts.Current.Label)
                {
                    <MudText Typo="Typo.caption">@Accounts.Current.Email</MudText>
                }
                <MudText Typo="Typo.caption">@SyncText.Describe(Sync, DateTimeOffset.Now)</MudText>
            </div>
        </MudMenuItem>
        <MudDivider />
        <MudMenuItem Icon="@Icons.Material.Filled.Sync" Disabled="@(!AppStatus.IsOnline || _busy || Sync.Status == SyncStatus.Syncing)" OnClick="SyncNowAsync">
            Sync now
        </MudMenuItem>
        <MudMenuItem Icon="@Icons.Material.Filled.Logout" Disabled="@_busy" OnClick="SignOutAsync">Sign out</MudMenuItem>
    </MudMenu>
}

@code {
    private bool _busy;

    protected override void OnInitialized()
    {
        Accounts.Changed += OnAccountChanged;
        AppStatus.Changed += OnAccountChanged;
        Sync.Changed += OnAccountChanged;
    }

    public void Dispose()
    {
        Accounts.Changed -= OnAccountChanged;
        AppStatus.Changed -= OnAccountChanged;
        Sync.Changed -= OnAccountChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !Accounts.Current.IsGuest)
        {
            await OfferGuestLibraryMoveAsync();
        }
    }

    private void OnAccountChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task SignInAsync()
    {
        _busy = true;
        try
        {
            // Navigates to the hosted sign-in page; the app restarts when it comes back.
            await Accounts.SignInAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _busy = false;
            Snackbar.Add("Sign-in couldn't start. Please try again.", Severity.Error);
        }
    }

    private async Task SignOutAsync()
    {
        // Give unsynced changes a chance to reach the server first, so "remove from this device" can be offered.
        if (Sync.IsEnabled && AppStatus.IsOnline && (Sync.PendingChanges > 0 || Sync.LastSyncedAt is null))
        {
            _busy = true;
            StateHasChanged();
            await Task.WhenAny(Sync.SyncNowAsync(), Task.Delay(TimeSpan.FromSeconds(15)));
            _busy = false;
        }

        var parameters = new DialogParameters
        {
            { nameof(SignOutDialog.PendingChanges), Sync.PendingChanges },
            { nameof(SignOutDialog.HasSynced), Sync.LastSyncedAt is not null },
        };
        var dialog = await Dialogs.ShowAsync<SignOutDialog>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled)
        {
            return;
        }

        var remove = result.Data is true;
        _busy = true;
        try
        {
            if (remove)
            {
                // Re-check right before deleting: an edit could have landed since the dialog opened.
                if (await Store.CountOutboxAsync() > 0)
                {
                    _busy = false;
                    Snackbar.Add("A change hasn't synced yet, so your library was kept on this device. Try again in a moment.", Severity.Warning);
                    return;
                }

                await LocalLibrary.EraseAsync();

                // "Remove my library from this device" means all of it, including any library from before
                // signing in, so the signed-out view starts empty.
                await GuestLibrary.DiscardGuestLibraryAsync();
            }

            await Accounts.SignOutAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _busy = false;
            Snackbar.Add("Sign-out failed. Please try again.", Severity.Error);
        }
    }

    private async Task SyncNowAsync()
    {
        if (await Sync.SyncNowAsync())
        {
            Snackbar.Add(
                Sync.PendingChanges == 0 ? "Your library is up to date." : SyncText.Describe(Sync, DateTimeOffset.Now),
                Severity.Success);
        }
        else
        {
            Snackbar.Add(Sync.Problem ?? "Couldn't sync right now. It will try again shortly.", Severity.Warning);
        }
    }

    /// <summary>
    /// Signed in while this device still has a library from before (the signed-out one): signing in means the
    /// device should show the account's library, so the only question is what happens to the books here.
    /// Merge them into the account, or use the account's library and discard them. Either way the signed-out
    /// library is emptied, so signing out later doesn't bring old books back. "Decide later" asks again next time.
    /// </summary>
    private async Task OfferGuestLibraryMoveAsync()
    {
        try
        {
            if (await GuestLibrary.CountGuestRecordsAsync() == 0)
            {
                return;
            }

            // Duplicates are found by comparing with the account's library, so get it first on a new device.
            if (Sync.IsEnabled && Sync.LastSyncedAt is null && AppStatus.IsOnline)
            {
                await Task.WhenAny(Sync.SyncNowAsync(), Task.Delay(TimeSpan.FromSeconds(90)));
            }

            var books = await GuestLibrary.CountGuestBooksAsync();
            var what = books switch
            {
                0 => "bookcases and settings",
                1 => "1 book",
                _ => $"{books} books",
            };
            var message = $"This device has {what} from before you signed in. "
                + "Merge them into your account's library, or use your account's library and remove them from this device?";

            var choice = await Dialogs.ShowMessageBoxAsync("You have books on this device", message,
                yesText: "Merge into my account", noText: "Use my account's library", cancelText: "Decide later");

            if (choice == true)
            {
                var result = await GuestLibrary.MoveGuestLibraryAsync(Accounts.Current.UserId);
                await LibraryData.ReloadAsync();
                var added = books - result.DuplicateBooks;
                var text = added == 1 ? "Added 1 book to your account." : $"Added {added} books to your account.";
                if (result.DuplicateBooks > 0)
                {
                    text += result.DuplicateBooks == 1
                        ? " 1 was already there, so its reading history and notes were combined."
                        : $" {result.DuplicateBooks} were already there, so their reading history and notes were combined.";
                }

                Snackbar.Add(text, Severity.Success);
                _ = Sync.SyncNowAsync(); // Upload them now rather than at the next scheduled pass.
            }
            else if (choice == false)
            {
                await GuestLibrary.DiscardGuestLibraryAsync();
                Snackbar.Add("Using your account's library on this device.", Severity.Normal);
            }

            StateHasChanged();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Snackbar.Add("Couldn't update the library on this device. Nothing was removed.", Severity.Error);
        }
    }
}
