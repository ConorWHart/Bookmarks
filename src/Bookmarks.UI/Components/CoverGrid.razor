@* Face-out grid of every book: the real cover when there is one, otherwise (or when it can't load) a color tile.
   Virtualized by row (Phase 6d): widthWatch.js reports the grid's width, the books are cut into rows of that many
   columns (group headings get a row of their own), and only the rows near the screen are rendered. *@
@using Microsoft.Extensions.Logging
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ILogger<CoverGrid> Log

<div class="bm-covers" @ref="_root">
    @if (_columns > 0)
    {
        <Virtualize Items="_rows" ItemSize="_rowHeight" OverscanCount="3" Context="row">
            @if (row.Group is { } group)
            {
                <div class="@(row.IsFirst ? "bm-covers__group bm-covers__group--first" : "bm-covers__group")">
                    <h2 class="bm-covers__group-title">@group.Key <span class="bm-covers__group-count">@group.Entries.Count</span></h2>
                </div>
            }
            else
            {
                <div class="bm-grid" style="@_gridStyle">
                    @foreach (var entry in row.Entries)
                    {
                        <button type="button" @key="entry.Id" class="@ItemClass(entry)" @onclick="() => OnSelected.InvokeAsync(entry)"
                                style="@TileStyle(entry)" title="@entry.Title">
                            <span class="bm-grid__title">@entry.Title</span>
                            <span class="bm-grid__author">@entry.Author</span>
                            @if (entry.Book.CoverUrl is { } cover)
                            {
                                <CoverImage Url="@cover" Size="CoverSize.Medium" Class="bm-grid__cover" />
                            }
                            @if (entry.Item.Status == OwnershipStatus.Wishlist)
                            {
                                <span class="bm-grid__wish" role="img" aria-label="On your wishlist" title="On your wishlist">
                                    <MudIcon Icon="@Icons.Material.Filled.Favorite" />
                                </span>
                            }
                        </button>
                    }
                </div>
            }
        </Virtualize>
    }
</div>

@code {
    // Matches the CSS: tiles at least 108px wide, 16px between columns, 22px between rows, 4px padding each side.
    // Phones (narrower than 600px) allow 96px tiles 12px apart, so even a 375px phone gets 3 columns (Phase 8a, H1).
    private const double MinTileWidth = 108;
    private const int ColumnGap = 16;
    private const double PhoneWidth = 600;
    private const double PhoneMinTileWidth = 96;
    private const int PhoneColumnGap = 12;
    private const double RowGap = 22;
    private const double SidePadding = 8;

    /// <summary>The books, when not grouped.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<LibraryEntry> Entries { get; set; } = [];

    /// <summary>When set, the books in sections with a heading each (Entries is then ignored).</summary>
    [Parameter] public IReadOnlyList<LibraryGroup>? Groups { get; set; }

    [Parameter] public EventCallback<LibraryEntry> OnSelected { get; set; }

    private sealed record Row(LibraryGroup? Group, IReadOnlyList<LibraryEntry> Entries, bool IsFirst = false);

    private ElementReference _root;
    private IJSObjectReference? _module;
    private DotNetObjectReference<CoverGrid>? _ref;

    private int _columns;
    private int _gap = ColumnGap;
    private float _rowHeight = 184;
    private string _gridStyle = "";
    private List<Row> _rows = [];

    private object? _builtFrom;
    private int _builtColumns;

    protected override void OnParametersSet() => BuildRows();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        double width;
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Bookmarks.UI/js/widthWatch.js");
            _ref = DotNetObjectReference.Create(this);
            width = await _module.InvokeAsync<double>("watch", _root, _ref);
        }
        catch (JSException ex)
        {
            Log.LogWarning(ex, "Couldn't measure the cover grid; using a fixed width.");
            width = 960;
        }

        SetWidth(width);
        StateHasChanged();
    }

    [JSInvokable]
    public Task OnWidthChanged(double width) => SetWidth(width) ? InvokeAsync(StateHasChanged) : Task.CompletedTask;

    /// <summary>Works out the columns for this width; true when the layout changed.</summary>
    private bool SetWidth(double width)
    {
        var phone = width < PhoneWidth;
        var minTile = phone ? PhoneMinTileWidth : MinTileWidth;
        var gap = phone ? PhoneColumnGap : ColumnGap;

        var inner = Math.Max(minTile, width - SidePadding);
        var columns = Math.Max(1, (int)Math.Floor((inner + gap) / (minTile + gap)));
        var tile = (inner - (gap * (columns - 1))) / columns;
        var rowHeight = (float)Math.Round((tile * 1.5) + RowGap);

        var changed = columns != _columns || gap != _gap || Math.Abs(rowHeight - _rowHeight) >= 1;
        _rowHeight = rowHeight;
        if (columns != _columns || gap != _gap)
        {
            var rebuild = columns != _columns;
            _columns = columns;
            _gap = gap;
            _gridStyle = $"grid-template-columns:repeat({columns},minmax(0,1fr));column-gap:{gap}px";
            if (rebuild)
            {
                BuildRows();
            }
        }

        return changed;
    }

    private void BuildRows()
    {
        object source = Groups is null ? Entries : Groups;
        if (_columns == 0 || (ReferenceEquals(source, _builtFrom) && _builtColumns == _columns))
        {
            return;
        }

        var rows = new List<Row>();
        if (Groups is null)
        {
            AddRows(rows, Entries);
        }
        else
        {
            foreach (var group in Groups)
            {
                rows.Add(new Row(group, [], IsFirst: rows.Count == 0));
                AddRows(rows, group.Entries);
            }
        }

        _rows = rows;
        _builtFrom = source;
        _builtColumns = _columns;
    }

    private void AddRows(List<Row> rows, IReadOnlyList<LibraryEntry> entries)
    {
        for (var i = 0; i < entries.Count; i += _columns)
        {
            rows.Add(new Row(null, entries.Skip(i).Take(_columns).ToList()));
        }
    }

    private static string ItemClass(LibraryEntry e)
        => e.Book.CoverUrl is null ? "bm-grid__item" : "bm-grid__item bm-grid__item--cover";

    private static string TileStyle(LibraryEntry e)
    {
        var fg = ColorUtil.SpineTextColor(e.SpineColor, e.Item.Appearance.TextColor, ornate: false);
        return $"--bm-book-bg:{e.SpineColor};--bm-book-fg:{fg};--bm-book-emboss:{ColorUtil.EmbossShadow(fg)};";
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("unwatch", _root);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
            catch (JSException)
            {
            }
        }

        _ref?.Dispose();
    }
}
