@inherits LayoutComponentBase
@using Microsoft.JSInterop
@implements IDisposable
@inject IAppStatusService AppStatus
@inject ISyncService Sync
@inject ISnackbar Snackbar

<MudThemeProvider Theme="BookmarksTheme.Default" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="@(_isDarkMode ? "bm-dark" : "bm-light")">
    <MudAppBar Elevation="0" Dense="true" Class="bm-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="() => _drawerOpen = !_drawerOpen" aria-label="Toggle navigation" />
        <MudText Typo="Typo.h6" Class="ml-2 bm-brand">Bookmarks</MudText>
        <MudSpacer />
        @if (!AppStatus.IsOnline)
        {
            <MudTooltip Text="You're offline. Everything still works and is saved on this device.">
                <span class="bm-offline" role="status">
                    <MudIcon Icon="@Icons.Material.Filled.CloudOff" Size="Size.Small" />
                    <span>Offline</span>
                </span>
            </MudTooltip>
        }
        <SyncIndicator />
        <AccountMenu />
        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit" OnClick="() => _isDarkMode = !_isDarkMode" aria-label="Toggle dark mode" />
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Variant="DrawerVariant.Responsive" Elevation="1">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen;
    private bool _isDarkMode;
    private bool _updateAnnounced;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        AppStatus.Changed += OnAppStatusChanged;
        try
        {
            await AppStatus.StartAsync();
        }
        catch (JSException)
        {
            // Status is a nicety; the app works without it.
        }

        // Background sync for signed-in accounts (does nothing for guests). Needs AppStatus started for online state.
        try
        {
            await Sync.StartAsync();
        }
        catch (JSException)
        {
            // The library keeps working locally; sync retries on the next start.
        }
    }

    public void Dispose() => AppStatus.Changed -= OnAppStatusChanged;

    private void OnAppStatusChanged() => _ = InvokeAsync(() =>
    {
        if (AppStatus.UpdateAvailable && !_updateAnnounced)
        {
            _updateAnnounced = true;
            Snackbar.Add("A new version of Bookmarks is ready.", Severity.Info, o =>
            {
                o.RequireInteraction = true;
                o.Action = "Reload";
                o.ActionColor = Color.Inherit;
                o.OnClick = _ => AppStatus.ApplyUpdateAsync();
            });
        }

        StateHasChanged();
    });
}
