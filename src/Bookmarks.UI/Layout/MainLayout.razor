@inherits LayoutComponentBase
@using Microsoft.JSInterop
@implements IDisposable
@inject IAppStatusService AppStatus
@inject ISyncService Sync
@inject ISnackbar Snackbar
@inject ThemeService ThemeState
@inject IBrowserViewportService Viewport

@* IsDarkMode is one-way: ThemeService decides. The provider only watches the system setting while the choice is
   "Match system"; otherwise a system switch would flip the theme behind the user's back. *@
<MudThemeProvider @ref="_themeProvider" Theme="BookmarksTheme.Default" IsDarkMode="ThemeState.IsDarkMode"
                  ObserveSystemDarkModeChange="@(ThemeState.Mode == ThemeMode.System)" />
<MudPopoverProvider />
<MudDialogProvider />
@* Back closes the open dialog (editor, shelf picker, message boxes…) instead of leaving the page. *@
<CloseDialogsOnBack />
<MudSnackbarProvider />

@* Styled only by this component's scoped CSS: js/pwa.js checks it to spot a page whose styles went missing. *@
<span class="bm-css-probe" aria-hidden="true"></span>

<MudLayout Class="@(ThemeState.IsDarkMode ? "bm-dark" : "bm-light")">
    <MudAppBar Elevation="0" Dense="true" Class="bm-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="ToggleDrawerAsync" aria-label="Toggle navigation" />
        <MudText Typo="Typo.h6" Class="ml-2 bm-brand">Bookmarks</MudText>
        <MudSpacer />
        @if (!AppStatus.IsOnline)
        {
            <MudTooltip Text="You're offline. Everything still works and is saved on this device.">
                <span class="bm-offline" role="status">
                    <MudIcon Icon="@Icons.Material.Filled.CloudOff" Size="Size.Small" />
                    <span>Offline</span>
                </span>
            </MudTooltip>
        }
        <SyncIndicator />
        <AccountMenu />
    </MudAppBar>

    @* Phones: the menu slides over the page, so Back closes it. (Wider screens keep it docked; no history entry.) *@
    <CloseOnBack Key="nav" Open="@(_drawerOpen && _drawerOverlays)" OnClose="() => _drawerOpen = false" />
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Variant="DrawerVariant.Responsive" Elevation="1">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen;

    /// <summary>The drawer covers the page (below MudBlazor's Md breakpoint, where Responsive acts as Temporary).</summary>
    private bool _drawerOverlays;

    private async Task ToggleDrawerAsync()
    {
        if (!_drawerOpen)
        {
            try
            {
                _drawerOverlays = (await Viewport.GetCurrentBrowserWindowSizeAsync()).Width < 960;
            }
            catch (JSException)
            {
                _drawerOverlays = false;
            }
        }

        _drawerOpen = !_drawerOpen;
    }
    private MudThemeProvider? _themeProvider;
    private bool _updateAnnounced;

    protected override void OnInitialized() => ThemeState.Changed += OnThemeChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await RestoreThemeAsync();

        AppStatus.Changed += OnAppStatusChanged;
        try
        {
            await AppStatus.StartAsync();
        }
        catch (JSException)
        {
            // Status is a nicety; the app works without it.
        }

        // Background sync for signed-in accounts (does nothing for guests). Needs AppStatus started for online state.
        try
        {
            await Sync.StartAsync();
        }
        catch (JSException)
        {
            // The library keeps working locally; sync retries on the next start.
        }
    }

    public void Dispose()
    {
        AppStatus.Changed -= OnAppStatusChanged;
        ThemeState.Changed -= OnThemeChanged;
    }

    /// <summary>The saved theme choice for this device (until one is picked, follow the system setting).</summary>
    private async Task RestoreThemeAsync()
    {
        if (_themeProvider is not { } provider)
        {
            return;
        }

        await provider.WatchSystemDarkModeAsync(ThemeState.OnSystemDarkModeChangedAsync);
        await ThemeState.InitializeAsync(provider.GetSystemDarkModeAsync);
    }

    private void OnThemeChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnAppStatusChanged() => _ = InvokeAsync(() =>
    {
        if (AppStatus.UpdateAvailable && !_updateAnnounced)
        {
            _updateAnnounced = true;
            Snackbar.Add("A new version of Bookmarks is ready.", Severity.Info, o =>
            {
                o.RequireInteraction = true;
                o.Action = "Reload";
                o.ActionColor = Color.Inherit;
                o.OnClick = _ => AppStatus.ApplyUpdateAsync();
            });
        }

        StateHasChanged();
    });
}
