@* Stack view (Phase 6d): books lying flat in piles on a table, spines facing out, in the view's sort order (top to
   bottom, then pile to pile). Each book is a normal BookSpine turned on its side. Rows of piles are virtualized like
   the cover grid: widthWatch.js reports the width and StackLayoutEngine packs the piles into rows. *@
@using Microsoft.Extensions.Logging
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ILogger<StackView> Log

<div class="bm-stacks" @ref="_root">
    @if (_width > 0)
    {
        <Virtualize Items="_rows" ItemSize="250" OverscanCount="2" Context="row">
            @if (row.Group is { } group)
            {
                <div class="@(row.IsFirst ? "bm-stacks__group bm-stacks__group--first" : "bm-stacks__group")">
                    <h2 class="bm-stacks__group-title">@group.Key <span class="bm-stacks__group-count">@group.Entries.Count</span></h2>
                </div>
            }
            else
            {
                <div class="bm-stacks__row">
                    <div class="bm-stacks__piles" style="@GapStyle">
                        @foreach (var pile in row.Piles)
                        {
                            <div class="bm-stack" style="@PileStyle(pile)">
                                @foreach (var book in pile.Books)
                                {
                                    <div @key="book.Entry.Id" class="bm-stack__book" style="@BookStyle(book)">
                                        <div class="bm-stack__turn" style="@TurnStyle(book)">
                                            <BookSpine Book="book" Scale="_scale" OnSelected="OnSelected" />
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    <div class="bm-stacks__table" aria-hidden="true"></div>
                </div>
            }
        </Virtualize>
    }
</div>

@code {
    private const double GapPx = 28;
    private const double SidePaddingPx = 24;
    private const double MaxPilePx = 230;
    private const double MinBookPx = 10;
    private const int MaxBooksPerPile = 12;

    /// <summary>The books, when not grouped.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<LibraryEntry> Entries { get; set; } = [];

    /// <summary>When set, the books in sections with a heading each (Entries is then ignored).</summary>
    [Parameter] public IReadOnlyList<LibraryGroup>? Groups { get; set; }

    [Parameter] public EventCallback<LibraryEntry> OnSelected { get; set; }

    private sealed record Row(LibraryGroup? Group, IReadOnlyList<BookPile> Piles, bool IsFirst = false);

    private ElementReference _root;
    private IJSObjectReference? _module;
    private DotNetObjectReference<StackView>? _ref;

    private double _width;
    private double _scale = 0.62;
    private List<Row> _rows = [];

    private object? _builtFrom;
    private double _builtWidth;

    private string GapStyle => $"gap:{Px(GapPx)}px";

    protected override void OnParametersSet() => BuildRows();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        double width;
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Bookmarks.UI/js/widthWatch.js");
            _ref = DotNetObjectReference.Create(this);
            width = await _module.InvokeAsync<double>("watch", _root, _ref);
        }
        catch (JSException ex)
        {
            Log.LogWarning(ex, "Couldn't measure the stack view; using a fixed width.");
            width = 960;
        }

        SetWidth(width);
        StateHasChanged();
    }

    [JSInvokable]
    public Task OnWidthChanged(double width)
    {
        SetWidth(width);
        return InvokeAsync(StateHasChanged);
    }

    private void SetWidth(double width)
    {
        _width = Math.Max(200, width);
        _scale = _width < 600 ? 0.5 : 0.62; // px per mm: an octavo is ~115 px long on a phone, ~140 px elsewhere
        BuildRows();
    }

    private void BuildRows()
    {
        object source = Groups is null ? Entries : Groups;
        if (_width <= 0 || (ReferenceEquals(source, _builtFrom) && _builtWidth == _width))
        {
            return;
        }

        var rows = new List<Row>();
        if (Groups is null)
        {
            AddRows(rows, Entries);
        }
        else
        {
            foreach (var group in Groups)
            {
                rows.Add(new Row(group, [], IsFirst: rows.Count == 0));
                AddRows(rows, group.Entries);
            }
        }

        _rows = rows;
        _builtFrom = source;
        _builtWidth = _width;
    }

    private void AddRows(List<Row> rows, IReadOnlyList<LibraryEntry> entries)
    {
        var piles = StackLayoutEngine.Piles(entries, Mm(MaxPilePx), MaxBooksPerPile, minThicknessMm: Mm(MinBookPx));
        foreach (var piled in StackLayoutEngine.Rows(piles, Mm(_width - SidePaddingPx), Mm(GapPx)))
        {
            rows.Add(new Row(null, piled));
        }
    }

    private int Mm(double px) => (int)Math.Ceiling(px / _scale);

    private static string Px(double value) => value.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    private string PileStyle(BookPile pile) => $"width:{Px(pile.WidthMm * _scale)}px";

    // A hand-made pile: each book sits a little off-centre and off-square, the same way every time.
    private string BookStyle(PlacedBook book)
    {
        var hash = book.Entry.Id.GetHashCode();
        var shift = ((hash & 0xFF) % 9) - 4;               // −4 … 4 px
        var tilt = ((((hash >> 8) & 0xFF) % 7) - 3) * 0.3; // −0.9° … 0.9°
        return $"width:{Px(book.HeightMm * _scale)}px;height:{Px(book.WidthMm * _scale)}px;"
            + $"transform:translateX({shift}px) rotate({Px(tilt)}deg)";
    }

    private string TurnStyle(PlacedBook book)
        => $"width:{Px(book.WidthMm * _scale)}px;height:{Px(book.HeightMm * _scale)}px";

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("unwatch", _root);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
            catch (JSException)
            {
            }
        }

        _ref?.Dispose();
    }
}
